---
import BaseLayout from "../layouts/BaseLayout.astro";
import GetStarted from "../components/GetStarted.astro";

const title = "CredShields | AI-led Security Audits & Pentesting";
const description = "CredShields secures apps, smart contracts, and Web3 protocols with AI-powered audits, pentesting, and continuous security for 200+ institutions.";
---

<BaseLayout title={title} description={description}>
    <!-- ═══════════════════════════════════════════════════════════
     SECTION 01 · HERO
════════════════════════════════════════════════════════════ -->
    <section id="top" class="rehaul-hero" aria-label="Hero">
      <div class="rehaul-hero-globe" aria-hidden="true">
        <canvas id="hero-globe-canvas"></canvas>
      </div>
      <div class="rehaul-hero-shade" aria-hidden="true"></div>
      <div class="rehaul-hero-inner">
        <div class="rehaul-hero-content">
          <div class="rehaul-hero-badge">
            <span class="rehaul-hero-badge-dot"></span>
            <span class="rehaul-hero-badge-text">AUTONOMOUS AI PENTESTING</span>
          </div>
          <h1 class="rehaul-hero-title">
            Pentesting at AI scale,
            <span>for every release</span>
          </h1>
          <p class="rehaul-hero-copy">
            CredShields One discovers, exploits, and proves vulnerabilities
            across your web, mobile, cloud, and API surface. Behind it sits a
            senior offensive security team that validates every finding.
          </p>
          <div class="rehaul-hero-actions">
            <a href="#contact" class="rehaul-btn rehaul-btn-primary"
              >Get Scoped</a
            >
            <a
              href="https://app.credshields.com"
              class="rehaul-btn rehaul-btn-secondary"
              target="_blank"
              rel="noopener noreferrer"
              >Log In to CredShields One ↗</a
            >
          </div>
          <div class="rehaul-hero-audience">
            BUILT FOR DEVOPS, ENGINEERING, AND SECURITY TEAMS
          </div>
        </div>

        <aside class="rehaul-hero-result" aria-label="What a run returns">
          <div class="rehaul-hero-result-label">WHAT A RUN RETURNS</div>
          <div class="rehaul-result-item">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <div>
              <div class="rehaul-result-title">Proven findings</div>
              <p>Each one exploited and reproduced, with the request chain attached.</p>
            </div>
          </div>
          <div class="rehaul-result-item">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <div>
              <div class="rehaul-result-title">Senior validation</div>
              <p>A pentester confirms or rules out every finding before it reaches you.</p>
            </div>
          </div>
          <div class="rehaul-result-item">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <div>
              <div class="rehaul-result-title">Retest on the next commit</div>
              <p>Push a fix and the same chain runs again.</p>
            </div>
          </div>
        </aside>
      </div>
      <div class="rehaul-hero-scroll" aria-hidden="true">
        <span>SCROLL</span>
        <i></i>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
     STATS STRIP
════════════════════════════════════════════════════════════ -->
    <!-- CHAIN stats strip -->
    <div class="stats-strip show-chain">
      <div class="stats-strip-grid">
        <div class="stats-strip-cell">
          <div class="stats-strip-val">$10B+</div>
          <div class="stats-strip-label">Value protected</div>
          <div class="stats-strip-sub">Across audited protocols</div>
        </div>
        <div class="stats-strip-cell">
          <div class="stats-strip-val">200+</div>
          <div class="stats-strip-label">Audits completed</div>
          <div class="stats-strip-sub">Since 2021</div>
        </div>
        <div class="stats-strip-cell">
          <div class="stats-strip-val">0</div>
          <div class="stats-strip-label">Post-audit exploits</div>
          <div class="stats-strip-sub">Zero · to date</div>
        </div>
        <div class="stats-strip-cell">
          <div class="stats-strip-val">99.9%</div>
          <div class="stats-strip-label">Uptime SLA</div>
          <div class="stats-strip-sub">24/7 monitoring</div>
        </div>
        <div class="stats-strip-cell">
          <div class="stats-strip-val">72h</div>
          <div class="stats-strip-label">Avg. delivery</div>
          <div class="stats-strip-sub">AI-led continuous pentest</div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
     TRUST LOGOS
════════════════════════════════════════════════════════════ -->
    <!-- CHAIN logos -->
    <div class="trust show-chain">
      <div class="trust-label">
        Trusted by industry leaders · 200+ protocols &amp; institutions
      </div>
      <div class="trust-logos">
        <span class="trust-pill">Canton</span>
        <span class="trust-pill">AVALANCHE</span>
        <span class="trust-pill">Rootstock</span>
        <span class="trust-pill">IMMUNEFI</span>
        <span class="trust-pill">Gnosis</span>
        <span class="trust-pill">XDC</span>
        <span class="trust-pill">Blockscout</span>
      </div>
      <div class="trust-logos" style="margin-top: 8px">
        <span class="trust-pill">CHECKMARX</span>
        <span class="trust-pill">IoTeX</span>
        <span class="trust-pill">HACKENPROOF</span>
        <span class="trust-pill">BuildBear</span>
        <span class="trust-pill">QUICKSWAP</span>
        <span class="trust-pill">Resonance</span>
        <span class="trust-pill">HEMI</span>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
     APPS-MODE CONTENT (sourced from apps_site/index.html)
════════════════════════════════════════════════════════════ -->

    <!-- APPS Client Logos -->
    <section class="rehaul-clients show-apps" aria-labelledby="clients-title">
      <div class="rehaul-clients-inner">
        <h2 id="clients-title" class="rehaul-clients-title">
          Trusted by teams shipping to production every week
        </h2>
        <div class="rehaul-client-logos">
          <div class="rehaul-client-card">
            <img
              class="rehaul-client-logo rehaul-client-logo-hawkins"
              src="images/logo-client-hawkins.png"
              alt="Hawkins"
              title="Hawkins"
              loading="lazy"
            />
          </div>
          <div class="rehaul-client-card">
            <img
              class="rehaul-client-logo"
              src="images/logo-client-tazapay.png"
              alt="Tazapay"
              title="Tazapay"
              loading="lazy"
            />
          </div>
          <div class="rehaul-client-card">
            <img
              class="rehaul-client-logo"
              src="images/logo-client-kappalab.png"
              alt="Kappa Lab"
              title="Kappa Lab"
              loading="lazy"
            />
          </div>
          <div class="rehaul-client-card">
            <img
              class="rehaul-client-logo"
              src="images/logo-client-qiro.png"
              alt="Qiro"
              title="Qiro"
              loading="lazy"
            />
          </div>
          <div class="rehaul-client-card">
            <img
              class="rehaul-client-logo rehaul-client-logo-juno"
              src="images/logo-client-juno.png"
              alt="Juno"
              title="Juno"
              loading="lazy"
            />
          </div>
          <div class="rehaul-client-card">
            <img
              class="rehaul-client-logo rehaul-client-logo-realproton"
              src="images/logo-client-realproton.png"
              alt="RealProton"
              title="RealProton"
              loading="lazy"
            />
          </div>
          <div class="rehaul-client-card">
            <img
              class="rehaul-client-logo"
              src="images/logo-client-capx.png"
              alt="Capx"
              title="Capx"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- APPS Platform Overview -->
    <section
      id="platform"
      class="rehaul-platform show-apps"
      aria-labelledby="platform-title"
    >
      <div class="rehaul-platform-inner">
        <div class="rehaul-platform-eyebrow">/ Inside the platform</div>
        <h2 id="platform-title" class="rehaul-platform-title">
          One run, end to end
        </h2>
        <p class="rehaul-platform-intro">
          One run, from mapped endpoints to a signed, compliance mapped report.
        </p>

        <figure class="rehaul-platform-feature rehaul-platform-card">
          <figcaption class="rehaul-platform-caption rehaul-platform-card-copy">
            <span class="rehaul-platform-caption-label">01 / OVERVIEW</span>
            <strong>Risk score, severity breakdown, and scan coverage for the release.</strong>
            <span>
              Every issue carries a CWE reference and a confidence score, ranked
              by impact.
            </span>
          </figcaption>
          <img
            class="rehaul-platform-card-image"
            src="images/product-overview.png"
            alt="CredShields One engagement overview: risk score, severity breakdown, scan coverage, and top high-impact issues"
          />
        </figure>

        <div class="rehaul-platform-cards">
          <figure class="rehaul-platform-figure rehaul-platform-card">
            <figcaption class="rehaul-platform-caption rehaul-platform-card-copy">
              <span class="rehaul-platform-caption-label">02 / FINDINGS</span>
              <strong>Every finding, searchable.</strong>
              <span>
                Severity, CWE, confidence, and the endpoint it was found on.
              </span>
            </figcaption>
            <img
              class="rehaul-platform-card-image"
              src="images/product-findings.png"
              alt="CredShields One findings list with severity, CWE, confidence, and affected endpoint"
              loading="lazy"
            />
          </figure>

          <figure class="rehaul-platform-figure rehaul-platform-card rehaul-platform-card-detail">
            <figcaption class="rehaul-platform-caption rehaul-platform-card-copy">
              <span class="rehaul-platform-caption-label">03 / FINDING DETAIL</span>
              <strong>Description, proof of concept, remediation.</strong>
              <span>
                Reproduction commands, root cause, and the code fix.
              </span>
            </figcaption>
            <div class="rehaul-platform-card-image-wrapper">
              <img
                class="rehaul-platform-card-image"
                src="images/product-finding-detail.png"
                alt="CredShields One finding detail with description, proof of concept, and remediation"
                loading="lazy"
              />
            </div>
          </figure>
        </div>
      </div>
    </section>
    <!-- APPS Product Position -->
    <section
      id="position"
      class="rehaul-position show-apps"
      aria-labelledby="position-title"
    >
      <div class="rehaul-position-inner">
        <div class="rehaul-platform-eyebrow">/ Where it fits</div>
        <h2 id="position-title" class="rehaul-platform-title">
          Vulnerability detection that keeps up with your releases
        </h2>
        <p class="rehaul-position-lead">
          <strong>
            CredShields One maps your attack surface, exploits what it finds,
            and proves which vulnerabilities are real.
          </strong>
          A senior pentester reviews every finding before it reaches you, and
          you decide which environment it runs against.
        </p>
        <p class="rehaul-position-copy">
          Most teams gate releases with DAST, SAST, or a scanner. Those tools
          flag patterns. CredShields One tests the way a pentester does: it
          exploits the issue, then proves it.
        </p>

      <div class="rehaul-workflow" aria-label="Release workflow" data-pipe="" style="position:relative;padding-top:8px;margin-bottom:8px">
        <div data-pipe-track="" style="position:absolute;left:12.5%;right:12.5%;top:calc(8px + 39px);height:1px;background:rgba(46,125,14,.18);z-index:0">
          <span data-pipe-pulse="" style="position:absolute;top:50%;left:0%;width:10px;height:10px;border-radius:50%;background:var(--color-forest);box-shadow:0 0 0 4px rgba(168,255,69,.32),0 0 14px rgba(46,125,14,.55);transform:translate(-50%,-50%);opacity:0"></span>
        </div>
        <div data-pipe-grid="" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px;align-items:stretch">
        <div data-pipe-card="" style="position:relative;z-index:1;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:20px 20px 18px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(10,26,12,.04);cursor:default">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <span data-pipe-icon="" style="position:relative;width:36px;height:36px;border-radius:50%;background:rgba(46,125,14,.09);border:1px solid rgba(46,125,14,.22);color:var(--color-forest);display:flex;align-items:center;justify-content:center;flex-shrink:0"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><line x1="1.05" y1="12" x2="8" y2="12"></line><line x1="16" y1="12" x2="22.95" y2="12"></line></svg></span>
            <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;white-space:nowrap">01 / COMMIT</span>
          </div>
          <div>
            <div style="font:500 15px/1.35 var(--font-body);color:var(--color-ink)">Engineering ships</div>
            <div class="rehaul-workflow-stage-steps">PUSH → MERGE</div>
            <div data-pipe-detail="" style="font:400 12px var(--font-mono);color:var(--text-secondary);letter-spacing:.04em">24 files changed</div>
          </div>
          <div class="rehaul-workflow-stage-status">
            <span class="rehaul-workflow-stage-track"><span data-pipe-stage-progress></span></span>
          </div>
        </div>
        <div data-pipe-card="" style="position:relative;z-index:1;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:20px 20px 18px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(10,26,12,.04);cursor:default">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <span data-pipe-icon="" style="position:relative;width:36px;height:36px;border-radius:50%;background:rgba(46,125,14,.09);border:1px solid rgba(46,125,14,.22);color:var(--color-forest);display:flex;align-items:center;justify-content:center;flex-shrink:0"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg></span>
            <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;white-space:nowrap">02 / BUILD</span>
          </div>
          <div>
            <div style="font:500 15px/1.35 var(--font-body);color:var(--color-ink)">CI runs</div>
            <div class="rehaul-workflow-stage-steps">BUILD → TEST</div>
            <div data-pipe-detail="" style="font:400 12px var(--font-mono);color:var(--text-secondary);letter-spacing:.04em">18 checks passed</div>
          </div>
          <div class="rehaul-workflow-stage-status">
            <span class="rehaul-workflow-stage-track"><span data-pipe-stage-progress></span></span>
          </div>
        </div>
        <div data-pipe-card="" style="position:relative;z-index:1;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:20px 20px 18px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(10,26,12,.04);cursor:default">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <span data-pipe-icon="" style="position:relative;width:36px;height:36px;border-radius:50%;background:rgba(46,125,14,.09);border:1px solid rgba(46,125,14,.22);color:var(--color-forest);display:flex;align-items:center;justify-content:center;flex-shrink:0"><svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg></span>
            <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;white-space:nowrap">03 / DEPLOY</span>
          </div>
          <div>
            <div style="font:500 15px/1.35 var(--font-body);color:var(--color-ink)">Release goes live</div>
            <div class="rehaul-workflow-stage-steps">DEPLOY → RELEASE</div>
            <div data-pipe-detail="" style="font:400 12px var(--font-mono);color:var(--text-secondary);letter-spacing:.04em">v2.8.4</div>
          </div>
          <div class="rehaul-workflow-stage-status">
            <span class="rehaul-workflow-stage-track"><span data-pipe-stage-progress></span></span>
          </div>
        </div>
        <div data-pipe-card="" data-pipe-gate="" style="position:relative;z-index:1;background:var(--surface-raised);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:20px 20px 18px;display:flex;flex-direction:column;gap:14px;box-shadow:0 2px 8px rgba(10,26,12,.04);cursor:default">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <span data-pipe-icon="" style="position:relative;width:36px;height:36px;border-radius:50%;background:rgba(46,125,14,.09);border:1px solid rgba(46,125,14,.22);color:var(--color-forest);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <svg data-pipe-ring="" width="48" height="48" viewBox="0 0 48 48" fill="none" style="position:absolute;top:-6px;left:-6px;width:48px;height:48px" aria-hidden="true"><circle cx="24" cy="24" r="22" stroke="rgba(46,125,14,.18)" stroke-width="1.5"></circle><circle cx="24" cy="24" r="22" stroke="var(--color-forest)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="42 96"></circle></svg>
              <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
            </span>
            <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;white-space:nowrap">04 / CS ONE</span>
          </div>
          <div>
            <div style="font:500 15px/1.35 var(--font-body);color:var(--color-ink)">CredShields One security gate</div>
            <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:5px;white-space:nowrap">ATTACK → VERIFY → RETEST</div>
            <div data-pipe-detail="" style="font:400 12px var(--font-mono);color:var(--text-secondary);letter-spacing:.04em">12 security checks</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:7px">
            <span data-pipe-status="" style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.1em;min-height:14px">IDLE</span>
            <span style="height:2px;background:rgba(46,125,14,.12);border-radius:1px;overflow:hidden;display:block"><span data-pipe-progress="" style="display:block;height:100%;width:0%;background:var(--color-forest);border-radius:1px"></span></span>
          </div>
        </div>
        </div>
      </div>
      </div>
    </section>
    <!-- APPS How It Works -->
    <section
      id="how"
      class="rehaul-how show-apps"
      aria-labelledby="how-title"
    >
      <div class="rehaul-how-inner">
        <div class="rehaul-platform-eyebrow">/ How it works</div>
        <h2 id="how-title" class="rehaul-platform-title">
          How CredShields One works
        </h2>
        <p class="rehaul-how-intro">
          Five stages. The AI handles scale, senior pentesters handle judgment.
        </p>

        <div class="rehaul-how-grid">
          <div class="rehaul-how-stages">
            <div class="rehaul-how-stage">
              <div class="rehaul-how-number">01</div>
              <div>
                <div class="rehaul-how-stage-heading">
                  <h3>Discover</h3>
                  <span class="rehaul-how-badge rehaul-how-badge-forest">AI + HUMAN</span>
                </div>
                <p>Maps your attack surface: web, mobile, APIs, auth paths, cloud.</p>
              </div>
            </div>
            <div class="rehaul-how-stage">
              <div class="rehaul-how-number">02</div>
              <div>
                <div class="rehaul-how-stage-heading">
                  <h3>Attack</h3>
                  <span class="rehaul-how-badge rehaul-how-badge-forest">AI + HUMAN</span>
                </div>
                <p>Tests APIs, sessions, and business logic on every release.</p>
              </div>
            </div>
            <div class="rehaul-how-stage">
              <div class="rehaul-how-number">03</div>
              <div>
                <div class="rehaul-how-stage-heading">
                  <h3>Verify</h3>
                  <span class="rehaul-how-badge rehaul-how-badge-lime">AI + HUMAN</span>
                </div>
                <p>Senior pentesters reproduce every exploit. False positives die here.</p>
              </div>
            </div>
            <div class="rehaul-how-stage">
              <div class="rehaul-how-number">04</div>
              <div>
                <div class="rehaul-how-stage-heading">
                  <h3>Report</h3>
                  <span class="rehaul-how-badge rehaul-how-badge-forest">AI + HUMAN</span>
                </div>
                <p>Audit-ready, mapped to SOC 2, ISO 27001, and GDPR. In days.</p>
              </div>
            </div>
            <div class="rehaul-how-stage rehaul-how-stage-last">
              <div class="rehaul-how-number">05</div>
              <div>
                <div class="rehaul-how-stage-heading">
                  <h3>Retest</h3>
                  <span class="rehaul-how-badge rehaul-how-badge-forest">AI + HUMAN</span>
                </div>
                <p>Re-runs the exact exploit chain against your patch.</p>
              </div>
            </div>
          </div>

          <div class="rehaul-how-demo">
            <div class="rehaul-terminal">
              <div class="rehaul-terminal-header">
                <span>~/credshields-one · zsh</span>
                <span class="rehaul-terminal-live">LIVE</span>
              </div>
              <div class="rehaul-terminal-body" aria-label="Example CredShields One run">
                <div>
                  <span class="rehaul-terminal-prompt">$</span>
                  cs-one pentest --target app.acme.io --scope cloud,api
                </div>
                <div>
                  <span class="rehaul-terminal-tag">[recon]&nbsp;&nbsp;</span>
                  mapped 1,284 endpoints · 27 auth flows
                </div>
                <div>
                  <span class="rehaul-terminal-tag">[attack]&nbsp;</span>
                  chained 14 exploits · 3 business-logic flaws
                </div>
                <div>
                  <span class="rehaul-terminal-tag">[human]&nbsp;&nbsp;</span>
                  reviewed by @m.laurent · 2 confirmed, 1 ruled out
                </div>
                <div>
                  <span class="rehaul-terminal-tag">[report]&nbsp;</span>
                  GDPR · SOC 2 · ISO 27001 · export ready
                </div>
                <div>
                  <span class="rehaul-terminal-tag">[retest]&nbsp;</span>
                  patch verified · 0 regressions
                </div>
                <div>
                  <span class="rehaul-terminal-prompt">$</span>
                  <span class="rehaul-terminal-cursor" aria-hidden="true"></span>
                </div>
              </div>
            </div>

            <div class="rehaul-scope-note">
              <div>SAFE BY SCOPE</div>
