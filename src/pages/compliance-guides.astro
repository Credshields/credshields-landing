---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import GetStarted from "../components/GetStarted.astro";
import complianceLogo0 from "../images/logo-soc2.png";
import complianceLogo1 from "../images/logo-iso27001.png";
import complianceLogo2 from "../images/logo-gdpr.png";
import complianceLogo3 from "../images/logo-pcidss.png";
import complianceLogo4 from "../images/logo-hipaa.png";
import "../styles/compliance-guides.css";

const title = "Compliance Guides - CredShields";
const description = "Practical penetration testing guides for SOC 2, PCI DSS, ISO 27001, HIPAA, and DORA.";
---

<BaseLayout title={title} description={description}>
  <div class="compliance-guides-page">
<section id="top" data-screen-label="Hero" style="background:var(--surface-page);border-bottom:1px solid var(--border-default);padding:150px 28px clamp(64px,8vw,88px);position:relative;overflow:hidden">
    <img src="/images/about-icon-black.png" alt="" style="position:absolute;right:-60px;top:50%;transform:translateY(-50%);width:440px;height:440px;opacity:.045;pointer-events:none">
    <div style="max-width:1180px;margin:0 auto;position:relative;z-index:2">
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--color-forest);border-radius:var(--radius-pill);padding:8px 16px;background:var(--color-forest-100);margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--color-forest);animation:pulseDot 2.6s infinite"></span>
        <span style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.18em">COMPLIANCE GUIDES</span>
      </div>
      <h1 style="font: 700 clamp(34px,4.4vw,58px)/1.06 var(--font-display); letter-spacing: -.03em; margin: 0; color: var(--color-forest); text-wrap: pretty">What each framework actually requires</h1>
      <p style="font: 400 18px/1.65 var(--font-body); color: var(--text-secondary); margin: 22px 0 30px; text-wrap: pretty">Most compliance content restates the standard back at you. These say what auditors accept, what they reject, and what it costs.</p>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <a href="#contact" class="cs-btn cs-btn-lime cs-btn-lg">Get Scoped</a>
        <a href="/" class="cs-btn cs-btn-secondary cs-btn-lg">See CredShields One</a>
      </div>
    </div>
  </section>
  <section id="guides" data-screen-label="All guides" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ All guides</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 40px;color:var(--color-forest);text-wrap:pretty">Seven guides</h2>
      
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px">
        <a href="Guide - SOC 2 Penetration Testing Requirements.html" style="display:flex;flex-direction:column;gap:12px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:30px 26px 26px;color:inherit;background:var(--surface-raised)">
          <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">SOC 2</span>
          <h3 style="font:600 19px/1.28 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">SOC 2 penetration testing requirements</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Which Trust Services Criteria a pentest evidences, what auditors accept, and how to scope against your system description.</p>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:8px">Read the guide →</span>
        </a>
        <a href="Guide - Pentest for SOC 2 Type II Checklist.html" style="display:flex;flex-direction:column;gap:12px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:30px 26px 26px;color:inherit;background:var(--surface-raised)">
          <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">SOC 2</span>
          <h3 style="font:600 19px/1.28 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Pentest for SOC 2 Type II: the checklist</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Twelve items that have to be true before fieldwork, with a working-backwards timeline.</p>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:8px">Read the guide →</span>
        </a>
        <a href="Guide - SOC 2 Pentest Cost.html" style="display:flex;flex-direction:column;gap:12px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:30px 26px 26px;color:inherit;background:var(--surface-raised)">
          <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">SOC 2</span>
          <h3 style="font:600 19px/1.28 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">How much does a SOC 2 pentest cost?</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Real market ranges, what drives the number, and how to compare quotes fairly.</p>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:8px">Read the guide →</span>
        </a>
        <a href="Guide - PCI DSS 11.4 Penetration Testing.html" style="display:flex;flex-direction:column;gap:12px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:30px 26px 26px;color:inherit;background:var(--surface-raised)">
          <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">PCI DSS</span>
          <h3 style="font:600 19px/1.28 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">PCI DSS 11.4 penetration testing</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Every sub-requirement in plain terms, plus why segmentation testing is where assessments fail.</p>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:8px">Read the guide →</span>
        </a>
        <a href="Guide - ISO 27001 Penetration Testing Requirements.html" style="display:flex;flex-direction:column;gap:12px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:30px 26px 26px;color:inherit;background:var(--surface-raised)">
          <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">ISO 27001</span>
          <h3 style="font:600 19px/1.28 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">ISO 27001 penetration testing requirements</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">The Annex A controls in play, scoping against your Statement of Applicability, and the certification cycle.</p>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:8px">Read the guide →</span>
        </a>
        <a href="Guide - HIPAA Penetration Testing Requirements.html" style="display:flex;flex-direction:column;gap:12px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:30px 26px 26px;color:inherit;background:var(--surface-raised)">
          <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">HIPAA</span>
          <h3 style="font:600 19px/1.28 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">HIPAA penetration testing requirements</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">How the Security Rule risk analysis and evaluation standards apply, and how to scope safely around PHI.</p>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:8px">Read the guide →</span>
        </a>
        <a href="Guide - DORA Threat-Led Penetration Testing.html" style="display:flex;flex-direction:column;gap:12px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:30px 26px 26px;color:inherit;background:var(--surface-raised)">
          <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">DORA</span>
          <h3 style="font:600 19px/1.28 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">DORA threat-led penetration testing explained</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Who is designated, how TIBER-EU maps on, the four phases, and how to prepare.</p>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:8px">Read the guide →</span>
        </a>
      </div>
      <div style="display:flex;align-items:center;gap:28px;flex-wrap:wrap;padding:26px 0;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);margin-top:36px">
        <span style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.16em;text-transform:uppercase">Reports map to</span>
        <div style="display:flex;gap:26px;flex-wrap:wrap;align-items:center">
          <Image src={complianceLogo0} alt="SOC 2" title="SOC 2" style="height:44px;width:auto;display:block;object-fit:contain" loading="lazy" />
          <Image src={complianceLogo1} alt="ISO 27001" title="ISO 27001" style="height:44px;width:auto;display:block;object-fit:contain" loading="lazy" />
          <Image src={complianceLogo2} alt="GDPR" title="GDPR" style="height:42px;width:auto;display:block;object-fit:contain" loading="lazy" />
          <Image src={complianceLogo3} alt="PCI DSS" title="PCI DSS" style="height:34px;width:auto;display:block;object-fit:contain" loading="lazy" />
          <Image src={complianceLogo4} alt="HIPAA" title="HIPAA" style="height:34px;width:auto;display:block;object-fit:contain" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
    <GetStarted />
  </div>
  <script>
    import "../../js/main.v1.js";
    import "../../js/homepage-rehaul.js";
  </script>
</BaseLayout>
