---
import BaseLayout from "../layouts/BaseLayout.astro";
import GetStarted from "../components/GetStarted.astro";
import "../styles/events.css";

const title = "Events - CredShields";
const description = "Talks, webinars, and workshops from the CredShields research team.";
---
<BaseLayout title={title} description={description}>
  <div class="events-page">
<section id="top" data-screen-label="Hero" style="background:var(--surface-page);border-bottom:1px solid var(--border-default);padding:150px 28px clamp(64px,8vw,88px);position:relative;overflow:hidden">
    <img src="images/about-icon-black.png" alt="" style="position:absolute;right:-60px;top:50%;transform:translateY(-50%);width:440px;height:440px;opacity:.045;pointer-events:none">
    <div style="max-width:1180px;margin:0 auto;position:relative;z-index:2">
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--color-forest);border-radius:var(--radius-pill);padding:8px 16px;background:var(--color-forest-100);margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--color-forest);animation:pulseDot 2.6s infinite"></span>
        <span style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.18em">EVENTS</span>
      </div>
      <h1 style="font: 700 clamp(34px,4.4vw,58px)/1.06 var(--font-display); letter-spacing: -.03em; margin: 0; color: var(--color-forest); text-wrap: pretty">Where we will be, and what we will say</h1>
      <p style="font: 400 18px/1.65 var(--font-body); color: var(--text-secondary); margin: 22px 0 30px; text-wrap: pretty">Conference talks, working sessions, and the research behind them. If we are on a stage, we have something specific to show.</p>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <a href="#contact" class="cs-btn cs-btn-lime cs-btn-lg">Get Scoped</a>
        <a href="" class="cs-btn cs-btn-secondary cs-btn-lg">See CredShields One</a>
      </div>
    </div>
  </section>
  <section id="upcoming" data-screen-label="Upcoming" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Upcoming</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 16px;color:var(--color-forest);text-wrap:pretty">What is coming up</h2>
      <p style="font: 400 18px/1.65 var(--font-body); color: var(--text-secondary); margin: 0 0 40px; text-wrap: pretty">Dates are being confirmed. Register interest and we will tell you when each one is scheduled.</p>
      <div style="display:flex;flex-direction:column">
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-forest);letter-spacing:.02em">TBC</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2026</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">CONFERENCE</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">Singapore</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">Speaking: proving exploitability at machine scale</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">How we keep a human validation layer in front of an AI pentester, and what breaks when you remove it.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-forest);white-space:nowrap;padding-top:2px">Details soon</span>
        </div>
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-forest);letter-spacing:.02em">TBC</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2026</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">WEBINAR</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">Online · 45 min</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">SOC 2 evidence that survives fieldwork</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">What auditors actually accept, what they reject, and the timing mistake that sinks most first audits.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-forest);white-space:nowrap;padding-top:2px">Register interest</span>
        </div>
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-forest);letter-spacing:.02em">TBC</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2026</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">WORKSHOP</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">Online · 90 min</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">Finding BOLA in your own API</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">A hands-on session on the authorization matrix, run against a deliberately broken test application.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-forest);white-space:nowrap;padding-top:2px">Register interest</span>
        </div>
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-forest);letter-spacing:.02em">TBC</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2026</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">CONFERENCE</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">Dubai</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">OWASP Smart Contract Top 10: what changed in 2026</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">The four new categories, the loss data behind them, and what it means for audit scope.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-forest);white-space:nowrap;padding-top:2px">Details soon</span>
        </div>
      </div>
    </div>
  </section>
  <section id="concluded" data-screen-label="Concluded" style="border-bottom:1px solid var(--border-default)">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Concluded</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 16px;color:var(--color-forest);text-wrap:pretty">Where we have already been</h2>
      <p style="font: 400 18px/1.65 var(--font-body); color: var(--text-secondary); margin: 0 0 40px; text-wrap: pretty">Sessions we have run. Ask us for the deck or the recording where one exists.</p>
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);opacity:.72;">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-dim);letter-spacing:.02em">NOV</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2025</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">CONFERENCE</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">Singapore</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">AI pentesting: where automation stops</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Why a human validation layer sits in front of our AI, and the finding classes that disappear without it.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-dim);white-space:nowrap;padding-top:2px">Concluded</span>
        </div>
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);opacity:.72;">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-dim);letter-spacing:.02em">SEP</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2025</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">WEBINAR</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">Online</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">SOC 2 evidence that survives fieldwork</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">The timing mistake that sinks first audits, and what auditors accept in place of a clean report.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-dim);white-space:nowrap;padding-top:2px">Concluded</span>
        </div>
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);opacity:.72;">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-dim);letter-spacing:.02em">JUL</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2025</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">WORKSHOP</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">Bangalore</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">Breaking multi-tenant authorization</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">A hands-on session on the authorization matrix, run against a deliberately broken application.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-dim);white-space:nowrap;padding-top:2px">Concluded</span>
        </div>
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);opacity:.72;">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-dim);letter-spacing:.02em">MAY</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2025</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">PANEL</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">Dubai</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">Custody security after the 2025 losses</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">What the year’s incidents had in common, and how much of it started off-chain.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-dim);white-space:nowrap;padding-top:2px">Concluded</span>
        </div>
      <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:24px 0 0"><a href="#contact" style="font-weight:500">Request a deck or recording →</a></p>
    </div>
  </section>
  <section id="past" data-screen-label="Published" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Published</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 40px;color:var(--color-forest);text-wrap:pretty">Research we have put out</h2>
      
      <div style="display:flex;flex-direction:column">
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);opacity:.72;">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-dim);letter-spacing:.02em">—</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2025</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">PUBLICATION</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">OWASP Foundation</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">OWASP Smart Contract Top 10, first edition</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Authored with the OWASP Foundation, supported by the Ethereum Foundation and built on $1.42B in 2024 loss data.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-dim);white-space:nowrap;padding-top:2px">Read it</span>
        </div>
        <div style="display:grid;grid-template-columns:minmax(96px,110px) minmax(0,1fr) auto;gap:24px;align-items:start;padding:24px 0;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);opacity:.72;">
          <div>
            <div style="font:600 15px var(--font-mono);color:var(--color-dim);letter-spacing:.02em">—</div>
            <div style="font:400 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em;margin-top:3px">2026</div>
          </div>
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:6px">
              <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">PUBLICATION</span>
              <span style="font:400 11px var(--font-mono);color:var(--text-secondary)">OWASP Foundation</span>
            </div>
            <h3 style="font:600 17.5px/1.28 var(--font-display);letter-spacing:-.015em;margin:0 0 5px;color:var(--color-ink);text-wrap:pretty">OWASP Smart Contract Top 10, 2026 edition</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Four new categories driven by $3.67B in 2025 losses across 134 documented incidents.</p>
          </div>
          <span style="font:500 12.5px var(--font-body);color:var(--color-dim);white-space:nowrap;padding-top:2px">Read it</span>
        </div>
      </div>
    </div>
  </section>
  <section id="speaking" data-screen-label="Speaking" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Speaking</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 40px;color:var(--color-forest);text-wrap:pretty">Want us at your event?</h2>
      
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">TALKS</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Conference sessions</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Offensive research, AI in security testing, and Web3 incident analysis. We present findings and reproduction steps.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">WORKSHOPS</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Hands-on sessions</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Ninety minutes against a deliberately broken application: authorization matrices, business logic, or smart contract review depending on your audience.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">PRIVATE</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Team sessions</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">A working session for your engineering or security team on the classes we find most often in environments like yours.</p>
        </div>
      </div>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:28px">
        <a href="#contact" class="cs-btn cs-btn-lime cs-btn-lg">Invite us to speak</a>
        <a href="Resources.html" class="cs-btn cs-btn-secondary cs-btn-lg">Read the research</a>
      </div>
    </div>
  </section>
  <section id="notify" data-screen-label="Stay posted" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Stay posted</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 40px;color:var(--color-forest);text-wrap:pretty">Hear about the next one</h2>
      
      <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);background:var(--surface-raised);padding:28px 30px;max-width:680px">
        <p style="font:400 15.5px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 18px;text-wrap:pretty">We announce sessions on the blog and to the newsletter list. Neither is frequent.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a href="https://discover.credshields.com/" target="_blank" rel="noopener" class="cs-btn cs-btn-secondary cs-btn-md">Read the blog ↗</a>
          <a href="#contact" class="cs-btn cs-btn-secondary cs-btn-md">Join the newsletter</a>
        </div>
      </div>
    </div>
  </section>
    <GetStarted />
  </div>
  <script>
    import "../../js/main.v1.js";
    import "../../js/homepage-rehaul.js";
  </script>
</BaseLayout>
