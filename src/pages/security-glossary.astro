    <GetStarted />
  </div>
  <script>
    import "../../js/main.v1.js";
    import "../../js/homepage-rehaul.js";

    const search = document.querySelector("[data-glossary-search]");
    const filters = document.querySelector("[data-glossary-filters]");
    const grid = document.querySelector("[data-glossary-grid]");
    const count = document.querySelector("[data-glossary-count]");
    const empty = document.querySelector("[data-glossary-empty]");
    let category = "all";

    const applyFilters = () => {
      if (!grid) return;
      const query = (search?.value ?? "").trim().toLowerCase();
      let shown = 0;
      grid.querySelectorAll("[data-cat]").forEach((card) => {
        const matchesCategory = category === "all" || card.dataset.cat === category;
        const matchesQuery = !query || card.dataset.term?.includes(query);
        const visible = matchesCategory && matchesQuery;
        card.style.display = visible ? "" : "none";
        if (visible) shown += 1;
      });
      if (count) count.textContent = `${shown} OF 69 TERMS`;
      if (empty) empty.style.display = shown ? "none" : "block";
      filters?.querySelectorAll("[data-filter-btn]").forEach((button) => {
        const active = button.dataset.filterBtn === category;
        button.style.background = active ? "var(--color-forest)" : "var(--surface-page)";
        button.style.color = active ? "#fff" : "var(--color-ink)";
        button.style.borderColor = active ? "var(--color-forest)" : "var(--border-default)";
      });
    };

    search?.addEventListener("input", applyFilters);
    filters?.querySelectorAll("[data-filter-btn]").forEach((button) => {
      button.addEventListener("click", () => {
        category = button.dataset.filterBtn ?? "all";
        applyFilters();
      });
    });
  </script>
