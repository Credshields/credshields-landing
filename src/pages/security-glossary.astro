---
import BaseLayout from "../layouts/BaseLayout.astro";
import GetStarted from "../components/GetStarted.astro";
import "../styles/security-glossary.css";

const title = "Security Glossary: 69 Vulnerability Classes - CredShields";
const description = "Plain-language definitions of the vulnerability classes that appear in real penetration tests, with CWE references and the testing service that covers each one.";
---

<BaseLayout title={title} description={description}>
  <div class="security-glossary-page">
<section id="top" data-screen-label="Hero" style="background:var(--surface-page);border-bottom:1px solid var(--border-default);padding:150px 28px clamp(56px,7vw,72px);position:relative;overflow:hidden">
    <img src="/images/about-icon-black.png" alt="" style="position:absolute;right:-60px;top:50%;transform:translateY(-50%);width:440px;height:440px;opacity:.045;pointer-events:none">
    <div style="max-width:1180px;margin:0 auto;position:relative;z-index:2">
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--color-forest);border-radius:var(--radius-pill);padding:8px 16px;background:var(--color-forest-100);margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--color-forest);animation:pulseDot 2.6s infinite"></span>
        <span style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.18em">SECURITY GLOSSARY</span>
      </div>
      <h1 style="font:700 clamp(36px,4.6vw,58px)/1.06 var(--font-display);letter-spacing:-.03em;margin:0;color:var(--color-forest);text-wrap:pretty">The vulnerability classes we actually find</h1>
      <p style="font: 400 18px/1.65 var(--font-body); color: var(--text-secondary); margin: 22px 0 0; text-wrap: pretty">Plain definitions for the flaws we find in real engagements, with the CWE reference and the service that tests for each.</p>
    </div>
  </section>

  <section id="glossary" data-screen-label="Glossary" style="border-bottom:1px solid var(--border-default)">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(48px,7vw,72px) 28px">
      <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-bottom:20px">
        <input data-glossary-search placeholder="Search a term, CWE, or keyword…" style="flex:1 1 280px;padding:13px 16px;border:1px solid var(--border-default);border-radius:var(--radius-sm);background:var(--surface-raised);font:400 15px var(--font-body);color:var(--color-ink);outline:none">
        <span style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.1em"><span data-glossary-count>69 OF 69 TERMS</span></span>
      </div>
      <div data-glossary-filters style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:32px">
        <button data-filter-btn="all" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--color-forest);background:var(--color-forest);color:#fff;cursor:pointer">All terms</button>
        <button data-filter-btn="access" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Access control</button>
        <button data-filter-btn="logic" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Business logic</button>
        <button data-filter-btn="injection" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Injection</button>
        <button data-filter-btn="auth" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Auth &amp; session</button>
        <button data-filter-btn="api" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">API</button>
        <button data-filter-btn="cloud" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Cloud &amp; infra</button>
        <button data-filter-btn="mobile" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Mobile</button>
        <button data-filter-btn="ai" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">AI &amp; LLM</button>
        <button data-filter-btn="web3" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Web3</button>
        <button data-filter-btn="supply" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Supply chain</button>
        <button data-filter-btn="data" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Data exposure</button>
      </div>
      <div data-glossary-grid style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px">
        <div data-cat="auth" data-term="account takeover (ato) cwe-640 the outcome, not the flaw: any chain that ends with an attacker in control of another user's account. password reset flows are the most common route." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">AUTH &amp; SESSION</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-640</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Account Takeover (ATO)</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">The outcome, not the flaw: any chain that ends with an attacker in control of another user's account. Password reset flows are the most common route.</p>
          <a href="/web-pentest" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Web App Pentesting →</a>
        </div>
        <div data-cat="auth" data-term="broken authentication cwe-287 any failure in proving who someone is: a flow entered halfway, a step skipped, a token accepted without verification, or a credential check the server assumes the client performed." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">AUTH &amp; SESSION</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-287</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Broken Authentication</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Any failure in proving who someone is: a flow entered halfway, a step skipped, a token accepted without verification, or a credential check the server assumes the client performed.</p>
          <a href="/web-pentest" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Web App Pentesting →</a>
        </div>
        <div data-cat="access" data-term="broken function level authorization cwe-285 an endpoint enforces authentication but not role. an ordinary user can call an administrative function simply by knowing the route exists." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">ACCESS CONTROL</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-285</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Broken Function Level Authorization</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">An endpoint enforces authentication but not role. An ordinary user can call an administrative function simply by knowing the route exists.</p>
          <a href="/api-security" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: API Security Testing →</a>
        </div>
        <div data-cat="access" data-term="broken object level authorization (bola) cwe-639 the server checks that you are logged in but not that the record you asked for belongs to you. changing an identifier in a request returns another tenant's data. consistently the most common and most damaging api vulnerability." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">ACCESS CONTROL</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-639</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Broken Object Level Authorization (BOLA)</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">The server checks that you are logged in but not that the record you asked for belongs to you. Changing an identifier in a request returns another tenant's data. Consistently the most common and most damaging API vulnerability.</p>
          <a href="/api-security" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: API Security Testing →</a>
        </div>
        <div data-cat="logic" data-term="business logic flaw cwe-840 a workflow that behaves incorrectly on its own terms: a step skipped, an approval bypassed, a value trusted from the client. no signature describes it, so scanners structurally cannot find it." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">BUSINESS LOGIC</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-840</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Business Logic Flaw</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">A workflow that behaves incorrectly on its own terms: a step skipped, an approval bypassed, a value trusted from the client. No signature describes it, so scanners structurally cannot find it.</p>
          <a href="/web-pentest" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Web App Pentesting →</a>
        </div>
        <div data-cat="mobile" data-term="certificate pinning bypass cwe-295 pinning defeated through a debug flag left in a release build or runtime hooking, allowing full interception of the mobile api with the client's protections stripped away." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">MOBILE</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-295</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Certificate Pinning Bypass</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Pinning defeated through a debug flag left in a release build or runtime hooking, allowing full interception of the mobile API with the client's protections stripped away.</p>
          <a href="/mobile-pentest" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Mobile App Pentesting →</a>
        </div>
        <div data-cat="supply" data-term="ci secret exposure cwe-522 workflow triggers that expose repository secrets to unreviewed forks, turning any pull request into a credential disclosure." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">SUPPLY CHAIN</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-522</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">CI Secret Exposure</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Workflow triggers that expose repository secrets to unreviewed forks, turning any pull request into a credential disclosure.</p>
          <a href="/devsecops" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: DevSecOps Integration →</a>
        </div>
        <div data-cat="data" data-term="cleartext transmission cwe-319 traffic carried over http, or tls configured with weak ciphers, exposing session tokens and transaction data to interception." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">DATA EXPOSURE</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-319</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Cleartext Transmission</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Traffic carried over HTTP, or TLS configured with weak ciphers, exposing session tokens and transaction data to interception.</p>
          <a href="/cloud-pentest" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Cloud Security Review →</a>
        </div>
        <div data-cat="cloud" data-term="cloud metadata service exposure cwe-918 an ssrf that reaches the instance metadata endpoint returns credentials for the workload's role, escalating a single vulnerable proxy into control of the environment." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">CLOUD &amp; INFRA</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-918</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Cloud Metadata Service Exposure</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">An SSRF that reaches the instance metadata endpoint returns credentials for the workload's role, escalating a single vulnerable proxy into control of the environment.</p>
          <a href="/cloud-pentest" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Cloud Security Review →</a>
        </div>
        <div data-cat="injection" data-term="command injection cwe-78 user input is passed to a shell. whatever the shell can do, the attacker can do, at the privilege level of the process." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">INJECTION</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-78</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Command Injection</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">User input is passed to a shell. Whatever the shell can do, the attacker can do, at the privilege level of the process.</p>
          <a href="/code-review-sast" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Source Code Review and SAST →</a>
        </div>
        <div data-cat="cloud" data-term="container escape cwe-269 breaking out of a container to the host node, usually via a privileged flag, a mounted socket, or a kernel capability nobody intended to grant." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">CLOUD &amp; INFRA</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-269</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Container Escape</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Breaking out of a container to the host node, usually via a privileged flag, a mounted socket, or a kernel capability nobody intended to grant.</p>
          <a href="/cloud-pentest" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Cloud Security Review →</a>
        </div>
        <div data-cat="auth" data-term="credential stuffing cwe-307 reusing breached username and password pairs at scale. rate limiting and mfa are the controls; neither is present in most first assessments." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">AUTH &amp; SESSION</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-307</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Credential Stuffing</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Reusing breached username and password pairs at scale. Rate limiting and MFA are the controls; neither is present in most first assessments.</p>
          <a href="/web-pentest" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Web App Pentesting →</a>
        </div>
        <div data-cat="auth" data-term="cross-site request forgery (csrf) cwe-352 a logged-in user's browser is induced to send a state-changing request they did not intend. samesite cookies and anti-csrf tokens close it." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">AUTH &amp; SESSION</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-352</span>
          </div>
          <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:pretty">Cross-Site Request Forgery (CSRF)</h3>
          <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">A logged-in user's browser is induced to send a state-changing request they did not intend. SameSite cookies and anti-CSRF tokens close it.</p>
          <a href="/web-pentest" style="font:500 12.5px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Where we test it: Web App Pentesting →</a>
        </div>
        <div data-cat="injection" data-term="cross-site scripting (xss) cwe-79 attacker-controlled content is rendered as markup in another user's browser, executing in that user's session. stored xss in an admin view is the high-value case." style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:32px 24px 24px;display:flex;flex-direction:column;gap:10px;background:var(--surface-raised)">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px">
            <span style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em">INJECTION</span>
            <span style="font:400 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.08em">CWE-79</span>
          </div>
