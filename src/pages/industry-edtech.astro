---
import BaseLayout from "../layouts/BaseLayout.astro";
import GetStarted from "../components/GetStarted.astro";
import "../styles/industry-edtech.css";

const title = "EdTech - CredShields";
const description = "Learning platforms, assessment tools, and school information systems. Scoped around student data, school district procurement, and exam integrity.";
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://credshields.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Industries",
      "item": "https://credshields.com/industries"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "EdTech",
      "item": "https://credshields.com/industry-edtech/"
    }
  ]
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <div class="industry-edtech-page">
<section id="top" data-screen-label="Hero" style="background:var(--surface-page);border-bottom:1px solid var(--border-default);padding:150px 28px clamp(64px,8vw,88px);position:relative;overflow:hidden">
    <img src="/images/about-icon-black.png" alt="" style="position:absolute;right:-60px;top:50%;transform:translateY(-50%);width:440px;height:440px;opacity:.045;pointer-events:none">
    <div style="max-width:1180px;margin:0 auto;position:relative;z-index:2">
      <span data-heroicon="" style="color:var(--color-forest);display:block;margin-bottom:18px;transform:scale(1.5);transform-origin:left center" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4.5A2.5 2.5 0 016.5 2H20v18H6.5A2.5 2.5 0 004 22z"/><path d="M4 17.5A2.5 2.5 0 016.5 15H20"/></svg></span>
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--color-forest);border-radius:var(--radius-pill);padding:8px 16px;background:var(--color-forest-100);margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--color-forest);animation:pulseDot 2.6s infinite"></span>
        <span style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.18em">INDUSTRY · EDTECH</span>
      </div>
      <h1 style="font: 700 clamp(34px,4.4vw,58px)/1.06 var(--font-display); letter-spacing: -.03em; margin: 0; color: var(--color-forest); text-wrap: pretty; max-width: 960px">Security testing for platforms holding student data</h1>
      <p style="font: 400 18px/1.65 var(--font-body); color: var(--text-secondary); margin: 22px 0 30px; text-wrap: pretty">Learning platforms, assessment tools, and school information systems. Scoped around student data, school district procurement, and exam integrity.</p>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <a href="#contact" class="cs-btn cs-btn-lime cs-btn-lg">Get Scoped</a>
        <a href="/" class="cs-btn cs-btn-secondary cs-btn-lg">See CredShields One</a>
      </div>
    </div>
  </section>
  <section data-screen-label="CredShields One" style="border-bottom:1px solid var(--border-default)">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(40px,6vw,64px) 28px">
      <div style="background:var(--surface-deep);border-radius:var(--radius-lg);padding:clamp(28px,4vw,44px);display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between">
        <div style="flex:1 1 460px;max-width:640px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
            <span class="cs-badge cs-badge-lime">Start here</span>
            <span style="font:500 11px var(--font-mono);color:var(--text-on-deep-muted);letter-spacing:.16em">CREDSHIELDS ONE</span>
          </div>
          <h2 style="font:600 clamp(22px,2.4vw,30px)/1.15 var(--font-display);letter-spacing:-.02em;margin:0 0 10px;color:var(--text-on-deep-primary);max-width:640px;text-wrap:balance">School districts and universities audit before they buy</h2>
          <p style="font:400 15px/1.65 var(--font-body);color:var(--text-on-deep-tertiary);margin:0;text-wrap:pretty">CredShields One gives you a pentest report dated this quarter for every procurement review, instead of a stale annual report that invites follow-up questions.</p>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a href="/" class="cs-btn cs-btn-lime cs-btn-md">Explore CredShields One</a>
          <a href="#contact" class="cs-btn cs-btn-secondary cs-btn-on-deep cs-btn-md">Talk it through</a>
        </div>
      </div>
    </div>
  </section>
  <section id="threats" data-screen-label="Threat landscape" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Threat landscape</div>
      <h2 style="font: 600 var(--type-display-2)/1.08 var(--font-display); letter-spacing: -.025em; margin: 0 0 16px; color: var(--color-forest); text-wrap: pretty">What actually goes wrong in education platforms</h2>
      <p style="font: 400 18px/1.65 var(--font-body); color: var(--text-secondary); margin: 0 0 40px; text-wrap: pretty">Role sprawl and integration surfaces, with student data raising the stakes.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">ROLE MODEL</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Student, teacher, parent, and admin overlap</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Education platforms have unusually complex role graphs. A student reaching teacher-level functions is the recurring finding.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">ASSESSMENT</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Exam and grading integrity</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Answer key exposure, submission tampering, and proctoring bypass. These are business-logic flaws, invisible to scanners.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">INTEGRATIONS</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">LTI, SIS, and rostering feeds</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">LTI launches, OneRoster syncs, and SIS connectors pass identity between systems that each trust the other to have checked.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">MINORS DATA</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Consent and data minimization</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">COPPA and GDPR-K impose obligations most platforms implement in policy but not in the access control layer.</p>
        </div>
      </div>
    </div>
  </section>
  <section id="regulation" data-screen-label="Regulation" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ What you have to prove</div>
      <h2 style="font: 600 var(--type-display-2)/1.08 var(--font-display); letter-spacing: -.025em; margin: 0 0 16px; color: var(--color-forest); text-wrap: pretty">What you have to prove, and to whom</h2>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">School district and university procurement is the real gate.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px">
        <div>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:14px">UNITED STATES</div>
          <div style="display:flex;flex-direction:column;gap:9px">
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>FERPA education records protection</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>COPPA for users under 13</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>State student privacy laws (SOPIPA and equivalents)</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Student Privacy Pledge commitments</span>
          </div>
        </div>
        <div>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:14px">INTERNATIONAL</div>
          <div style="display:flex;flex-direction:column;gap:9px">
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>GDPR and GDPR-K for minors</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>UK DfE data protection expectations</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Regional data residency for student records</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Age-appropriate design code (UK)</span>
          </div>
        </div>
        <div>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:14px">PROCUREMENT</div>
          <div style="display:flex;flex-direction:column;gap:9px">
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>SOC 2 Type II for district review</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>ISO 27001 for university tenders</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Accessibility and security questionnaire responses</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Sub-processor disclosure</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section id="findings" data-screen-label="Common findings" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ What we keep finding</div>
      <h2 style="font: 600 var(--type-display-2)/1.08 var(--font-display); letter-spacing: -.025em; margin: 0 0 16px; color: var(--color-forest); text-wrap: pretty">What we keep finding in EdTech</h2>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">From recent engagements in this sector.</p>
      <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);overflow:hidden;background:var(--surface-raised)">
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:9px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="cs-severity cs-severity-critical">Critical</span>
            <span class="cs-proof cs-proof-proven"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Proven</span>
            <span style="font:500 11px var(--font-mono);color:var(--color-danger-strong)">CVSS 8.8</span>
          </div>
          <div style="font:500 14.5px/1.4 var(--font-mono);color:var(--color-ink);text-wrap:pretty">Student account reached grade modification through an unguarded admin route</div>
          <div style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);text-wrap:pretty">Three administrative routes had been registered outside the blueprint carrying the role decorator. Any authenticated student could call them directly.</div>
        </div>
        <div style="padding:20px 24px;border-top:1px solid var(--border-default);display:flex;flex-direction:column;gap:9px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="cs-severity cs-severity-high">High</span>
            <span class="cs-proof cs-proof-proven"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Proven</span>
            <span style="font:500 11px var(--font-mono);color:var(--color-warning-strong)">CVSS 7.9</span>
          </div>
          <div style="font:500 14.5px/1.4 var(--font-mono);color:var(--color-ink);text-wrap:pretty">LTI launch accepted an unsigned role claim</div>
          <div style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);text-wrap:pretty">The launch handler read the role parameter without verifying the OAuth signature, so a student launch could assert instructor privileges.</div>
        </div>
        <div style="padding:20px 24px;border-top:1px solid var(--border-default);display:flex;flex-direction:column;gap:9px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="cs-severity cs-severity-medium">Medium</span>
            <span class="cs-proof cs-proof-proven"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Proven</span>
            <span style="font:500 11px var(--font-mono);color:var(--color-warning-strong)">CVSS 6.8</span>
          </div>
          <div style="font:500 14.5px/1.4 var(--font-mono);color:var(--color-ink);text-wrap:pretty">Assessment answers returned in the question payload</div>
          <div style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);text-wrap:pretty">The client-side quiz component received correct answers with the question set so it could grade offline, visible in any browser inspector.</div>
        </div>
      </div>
    </div>
  </section>
  <section id="services" data-screen-label="Services" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Where teams here start</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 16px;color:var(--color-forest);text-wrap:pretty">Where teams here start</h2>
      <p style="font: 400 18px/1.65 var(--font-body); color: var(--text-secondary); margin: 0 0 40px; text-wrap: pretty">Most EdTech clients need evidence for procurement first and depth second.</p>
      <div style="display:flex;flex-direction:column">
        <a href="/" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">CredShields One</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">Tested every release, evidence always current</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more →</span>
        </a>
        <a href="/web-pentest" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">Web App Pentesting</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">Full role-matrix testing across student, teacher, and admin</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more →</span>
        </a>
        <a href="/compliance" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">Compliance Readiness</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">SOC 2 and student privacy evidence for district review</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more →</span>
        </a>
        <a href="/api-security" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">API Security Testing</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">LTI, OneRoster, and SIS integration authorization</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more →</span>
        </a>
      </div>
    </div>
  </section>
  <section id="proof" data-screen-label="Customer proof" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Customer proof</div>
      <h2 style="font: 600 var(--type-display-2)/1.08 var(--font-display); letter-spacing: -.025em; margin: 0 0 40px; color: var(--color-forest); text-wrap: pretty">A learning platform, three routes</h2>
      
      <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:clamp(28px,4vw,44px);display:flex;flex-wrap:wrap;gap:40px;align-items:flex-start">
        <div style="flex:1 1 380px;max-width:620px">
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;margin-bottom:16px">EDTECH · SERIES A</div>
          <p style="font:500 var(--type-pull-quote)/1.35 var(--font-display);letter-spacing:-.015em;color:var(--color-ink);margin:0 0 16px;text-wrap:balance">Their static analysis had 1,400 open alerts. The three routes a student could use to change grades were not among them.</p>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Administrative routes added during a release crunch bypassed the decorator enforcing role checks. Every tool read the code as correct, because it was. Only comparing the routing table against the decorator list exposed the gap.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;min-width:180px">
          <div><div style="font:700 30px var(--font-display);letter-spacing:-.02em;color:var(--color-forest)">3</div><div style="font:500 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em;margin-top:4px">UNPROTECTED ROUTES</div></div>
          <div><div style="font:700 30px var(--font-display);letter-spacing:-.02em;color:var(--color-forest)">1,400</div><div style="font:500 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em;margin-top:4px">ALERTS BEFORE</div></div>
          <div><div style="font:700 30px var(--font-display);letter-spacing:-.02em;color:var(--color-forest)">300</div><div style="font:500 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em;margin-top:4px">ALERTS AFTER</div></div>
        </div>
      </div>
    </div>
  </section>
  <section data-screen-label="Timing" style="border-bottom:1px solid var(--border-default)">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(48px,7vw,72px) 28px">
      <div style="border-left:3px solid var(--color-forest);padding:8px 0 8px 24px;max-width:760px">
        <p style="font:500 var(--type-pull-quote)/1.35 var(--font-display);letter-spacing:-.015em;color:var(--color-ink);margin:0 0 14px;text-wrap:balance">Procurement cycles are seasonal. Testing should not be.</p>
        <p style="font:400 15.5px/1.65 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">District buying happens in a narrow window each year, and a security review sits in front of it. If your evidence needs to be ready before that window opens, work backwards from it with us.</p>
      </div>
    </div>
  </section>
  <section id="faq" data-screen-label="FAQ" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
