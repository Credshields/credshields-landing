---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import GetStarted from "../components/GetStarted.astro";
import complianceLogo0 from "../images/logo-soc2.png";
import complianceLogo1 from "../images/logo-iso27001.png";
import complianceLogo2 from "../images/logo-gdpr.png";
import complianceLogo3 from "../images/logo-pcidss.png";
import complianceLogo4 from "../images/logo-hipaa.png";
import "../styles/services.css";

const title = "Services - CredShields";
const description = "Nine security services delivered by our own team. A named lead on every engagement, a signed report at the end, and a retest once your fixes land.";
---

<BaseLayout title={title} description={description}>
<div class="services-page">
<section id="top" data-screen-label="Hero" style="background:var(--surface-page);border-bottom:1px solid var(--border-default);padding:150px 28px clamp(64px,8vw,88px);position:relative;overflow:hidden">
    <img src="images/about-icon-black.png" alt="" style="position:absolute;right:-60px;top:50%;transform:translateY(-50%);width:440px;height:440px;opacity:.045;pointer-events:none">
    <div style="max-width:1180px;margin:0 auto;position:relative;z-index:2">
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--color-forest);border-radius:var(--radius-pill);padding:8px 16px;background:var(--color-forest-100);margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--color-forest);animation:pulseDot 2.6s infinite"></span>
        <span style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.18em">CREDSHIELDS SERVICES</span>
      </div>
      <h1 style="font:700 clamp(34px,4.4vw,58px)/1.06 var(--font-display);letter-spacing:-.03em;margin:0;color:var(--color-forest);max-width:960px;text-wrap:pretty">Senior-led security engagements</h1>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:22px 0 30px;max-width:760px;text-wrap:pretty">Nine services delivered by our own team, never subcontracted. A named lead on every engagement, a signed report at the end, and a retest once your fixes land. We hold a SOC 2 Type II report ourselves.</p>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <a href="#contact" class="cs-btn cs-btn-lime cs-btn-lg">Get Scoped</a>
        <a href="" class="cs-btn cs-btn-secondary cs-btn-lg">See CredShields One</a>
        <a data-herodemo="" href="https://calendly.com/shashank-credshields/credshields?month=2026-09" target="_blank" rel="noopener" style="font:500 14.5px var(--font-body);color:var(--color-forest);white-space:nowrap">Book a demo &#8599;</a>
      </div>
    </div>
  </section>
  <section id="ways" data-screen-label="Two ways to engage" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Two ways to engage</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 40px;color:var(--color-forest);text-wrap:pretty">Two ways to work with us</h2>
      
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px">
        <div style="border:1px solid var(--color-forest);background:var(--color-forest-100);border-radius:var(--radius-md);padding:30px;display:flex;flex-direction:column;gap:12px">
          <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.4-2.9 7.9-7 9-4.1-1.1-7-4.6-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.14em">THE PLATFORM</div>
          <h3 style="font:600 22px/1.2 var(--font-display);letter-spacing:-.02em;margin:0;color:var(--color-ink)">CredShields One</h3>
          <p style="font:400 15px/1.65 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Autonomous pentesting on every release, validated by a senior pentester before anything reaches you. Priced as a subscription, retests included.</p>
          <div style="display:flex;flex-direction:column;gap:7px;font:400 14px/1.5 var(--font-body);color:var(--color-ink);margin-top:4px">
            <span><span style="color:var(--color-forest)">&#8250;</span> Runs on your shipping cadence</span>
            <span><span style="color:var(--color-forest)">&#8250;</span> Evidence stays current between audits</span>
            <span><span style="color:var(--color-forest)">&#8250;</span> Zero triage burden on your engineers</span>
          </div>
          <a href="" class="cs-btn cs-btn-lime cs-btn-md" style="margin-top:auto;align-self:flex-start">Explore CredShields One</a>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:30px;display:flex;flex-direction:column;gap:12px">
          <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l4-4 3 2 2-2 2 2 3-2 4 4"/><path d="M7 12l3 3a1.5 1.5 0 002 0l4-4"/></svg></span>
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">THE ENGAGEMENTS</div>
          <h3 style="font:600 22px/1.2 var(--font-display);letter-spacing:-.02em;margin:0;color:var(--color-ink)">CredShields Services</h3>
          <p style="font:400 15px/1.65 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Scoped, senior-led engagements with a named lead and a signed report. For a first deep assessment, an audit requirement, or work the platform is not built to do.</p>
          <div style="display:flex;flex-direction:column;gap:7px;font:400 14px/1.5 var(--font-body);color:var(--color-ink);margin-top:4px">
            <span><span style="color:var(--color-forest)">&#8250;</span> A named pentester, not a queue</span>
            <span><span style="color:var(--color-forest)">&#8250;</span> Fixed scope, fixed delivery date</span>
            <span><span style="color:var(--color-forest)">&#8250;</span> Retest after remediation</span>
          </div>
          <a href="#catalog" class="cs-btn cs-btn-secondary cs-btn-md" style="margin-top:auto;align-self:flex-start">See all services</a>
        </div>
      </div>
      <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:24px 0 0;max-width:700px;text-wrap:pretty">Most teams run both: the platform for cadence, an engagement when depth or an auditor demands it. If you are not sure which fits, say so on the form and we will tell you plainly.</p>
    </div>
  </section>
  <section id="catalog" data-screen-label="Service catalog" style="border-bottom:1px solid var(--border-default)">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Service catalog</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 40px;color:var(--color-forest);text-wrap:pretty">Nine services, one team</h2>
      <div style="margin-bottom:40px">
        <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:20px">MANUAL + AI PENTESTING</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px">
          <a href="web-pentest.html" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 010 18a15 15 0 010-18"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">Web App Pentesting</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Authenticated testing across business logic, tenant boundaries, and auth flows a scanner never reaches.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Learn more &#8594;</span>
          </a>
          <a href="mobile-pentest.html" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">Mobile App Pentesting</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">iOS, Android, and cross-platform. On-device testing, runtime instrumentation, and the backend behind it.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Learn more &#8594;</span>
          </a>
          <a href="api-security.html" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4H6a2 2 0 00-2 2v3a2 2 0 01-2 2 2 2 0 012 2v3a2 2 0 002 2h2"/><path d="M16 4h2a2 2 0 012 2v3a2 2 0 002 2 2 2 0 00-2 2v3a2 2 0 01-2 2h-2"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">API Security Testing</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">REST, GraphQL, gRPC, and WebSocket. Every operation tested as every role.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Learn more &#8594;</span>
          </a>
          <a href="cloud-security.html" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 18a4 4 0 000-8 6 6 0 00-11.6 1.6A3.5 3.5 0 006.5 18z"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">Cloud Security Review</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">AWS, GCP, and Azure. Attack paths traced through the identity graph.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Learn more &#8594;</span>
          </a>
          <a href="red-team.html" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">Red Team Engagement</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">One objective, every authorized route to it, and an honest account of what your detection caught.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Learn more &#8594;</span>
          </a>
        </div>
      </div>
      <div style="margin-bottom:40px">
        <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:20px">CONTINUOUS AND TOOLING</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px">
          <a href="devsecops.html" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="6" r="2.2"/><circle cx="7" cy="18" r="2.2"/><circle cx="17" cy="9" r="2.2"/><path d="M7 8.2v7.6M17 11.2a5 5 0 01-5 5H9.2"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">DevSecOps Integration</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Pipeline gates tuned so builds only fail on proven findings, with results in the tools your team already uses.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Learn more &#8594;</span>
          </a>
          <a href="sast.html" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l-6-6 6-6M15 6l6 6-6 6"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">Source Code Review and SAST</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Manual review of the security-critical paths, plus tuning your existing SAST until its output is worth reading.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Learn more &#8594;</span>
          </a>
        </div>
      </div>
      <div style="margin-bottom:40px">
        <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:20px">SPECIALIZED</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px">
          <a href="ai-llm-security.html" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5.5a3 3 0 00-6 .5 2.8 2.8 0 00-1 4.6A3 3 0 007 16a3 3 0 005 2.2z"/><path d="M12 5.5a3 3 0 016 .5 2.8 2.8 0 011 4.6A3 3 0 0117 16a3 3 0 01-5 2.2z"/><path d="M12 5.5v13"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">AI and LLM AppSec</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Prompt injection, agent and tool-call abuse, RAG leakage, and the authorization holes AI features introduce.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Learn more &#8594;</span>
          </a>
          <a href="compliance.html" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3a1 1 0 011-1h4a1 1 0 011 1v1"/><path d="M9 11h6M9 15h4"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">Compliance Readiness</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">SOC 2, ISO 27001, PCI DSS, HIPAA, and GDPR. Testing to the framework, evidence mapped to controls.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Learn more &#8594;</span>
          </a>
          <a href="https://solidityscan.com/" target="_blank" rel="noopener" style="display:flex;flex-direction:column;gap:9px;border:1px solid var(--border-default);border-radius:var(--radius-md);padding:24px;color:inherit" class="services-catalog-card">
            <span aria-hidden="true" style="color:var(--color-forest);display:block;margin-bottom:2px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 17h4"/></svg></span>
            <h3 style="font:600 17px/1.25 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink)">Smart contract audits</h3>
            <p style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Solidity and EVM contracts, manually reviewed and backed by SolidityScan, our own scanner.</p>
            <span style="font:500 13px var(--font-body);color:var(--color-forest);margin-top:auto;padding-top:6px">Visit SolidityScan &#8599;</span>
          </a>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:28px;flex-wrap:wrap;padding:26px 0;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);margin-top:36px">
        <span style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.16em;text-transform:uppercase">Reports map to</span>
        <div style="display:flex;gap:26px;flex-wrap:wrap;align-items:center">
          <Image src={complianceLogo0} alt="SOC 2" title="SOC 2" style="height:44px;width:auto;display:block;object-fit:contain" loading="lazy" />
          <Image src={complianceLogo1} alt="ISO 27001" title="ISO 27001" style="height:44px;width:auto;display:block;object-fit:contain" loading="lazy" />
          <Image src={complianceLogo2} alt="GDPR" title="GDPR" style="height:42px;width:auto;display:block;object-fit:contain" loading="lazy" />
          <Image src={complianceLogo3} alt="PCI DSS" title="PCI DSS" style="height:34px;width:auto;display:block;object-fit:contain" loading="lazy" />
          <Image src={complianceLogo4} alt="HIPAA" title="HIPAA" style="height:34px;width:auto;display:block;object-fit:contain" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
  <section id="process" data-screen-label="How engagements run" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ How engagements run</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 16px;color:var(--color-forest);text-wrap:pretty">The same shape, whatever the service</h2>
      <p style="font:400 var(--type-body-lg)/1.6 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">You get a channel with the pentester on day one.</p>
      
      <div style="display:flex;flex-direction:column">
        <div style="display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:20px;align-items:baseline;padding:20px 0;border-top:1px solid var(--border-default);">
          <span style="font:600 13px var(--font-mono);color:var(--color-dim)">01</span>
          <div>
            <h3 style="font:600 17px/1.2 var(--font-display);letter-spacing:-.015em;margin:0 0 6px;color:var(--color-ink)">Scoping call</h3>
            <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Thirty minutes to agree targets, environments, access, and rules of engagement. You get a fixed quote and a delivery date.</p>
          </div>
          <span style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.1em;white-space:nowrap">2-3 days</span>
        </div>
        <div style="display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:20px;align-items:baseline;padding:20px 0;border-top:1px solid var(--border-default);">
          <span style="font:600 13px var(--font-mono);color:var(--color-dim)">02</span>
          <div>
            <h3 style="font:600 17px/1.2 var(--font-display);letter-spacing:-.015em;margin:0 0 6px;color:var(--color-ink)">Access and kickoff</h3>
