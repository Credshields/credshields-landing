---
import BaseLayout from "../layouts/BaseLayout.astro";
import GetStarted from "../components/GetStarted.astro";
import "../styles/fintech-security.css";

const title = "Finance and Fintech - CredShields";
const description = "Payments, lending, neobanks, and trading platforms. Testing scoped to the money movement paths and the regulators who audit them.";
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://credshields.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Industries",
      "item": "https://credshields.com/industries"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Finance and Fintech",
      "item": "https://credshields.com/fintech-security/"
    }
  ]
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <div class="fintech-security-page">
<section id="top" data-screen-label="Hero" style="background:var(--surface-page);border-bottom:1px solid var(--border-default);padding:150px 28px clamp(64px,8vw,88px);position:relative;overflow:hidden">
    <img src="/images/about-icon-black.png" alt="" style="position:absolute;right:-60px;top:50%;transform:translateY(-50%);width:440px;height:440px;opacity:.045;pointer-events:none">
    <div style="max-width:1180px;margin:0 auto;position:relative;z-index:2">
      <span data-heroicon="" style="color:var(--color-forest);display:block;margin-bottom:18px;transform:scale(1.5);transform-origin:left center" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6.5" rx="7" ry="3"/><path d="M5 6.5v11c0 1.7 3.1 3 7 3s7-1.3 7-3v-11"/><path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/></svg></span>
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--color-forest);border-radius:var(--radius-pill);padding:8px 16px;background:var(--color-forest-100);margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--color-forest);animation:pulseDot 2.6s infinite"></span>
        <span style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.18em">INDUSTRY · FINANCE AND FINTECH</span>
      </div>
      <h1 style="font:700 clamp(34px,4.4vw,58px)/1.06 var(--font-display);letter-spacing:-.03em;margin:0;color:var(--color-forest);max-width:960px;text-wrap:pretty">Security testing for teams that move other people’s money</h1>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:22px 0 30px;max-width:760px;text-wrap:pretty">Payments, lending, neobanks, and trading platforms. Testing scoped to the money movement paths and the regulators who audit them.</p>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <a href="#contact" class="cs-btn cs-btn-lime cs-btn-lg">Get Scoped</a>
        <a href="/" class="cs-btn cs-btn-secondary cs-btn-lg">See CredShields One</a>
      </div>
    </div>
  </section>
  <section data-screen-label="CredShields One" style="border-bottom:1px solid var(--border-default)">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(40px,6vw,64px) 28px">
      <div style="background:var(--surface-deep);border-radius:var(--radius-lg);padding:clamp(28px,4vw,44px);display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between">
        <div style="flex:1 1 460px;max-width:640px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
            <span class="cs-badge cs-badge-lime">Start here</span>
            <span style="font:500 11px var(--font-mono);color:var(--text-on-deep-muted);letter-spacing:.16em">CREDSHIELDS ONE</span>
          </div>
          <h2 style="font:600 clamp(22px,2.4vw,30px)/1.15 var(--font-display);letter-spacing:-.02em;margin:0 0 10px;color:var(--text-on-deep-primary);text-wrap:balance">Regulators want current evidence</h2>
          <p style="font:400 15px/1.65 var(--font-body);color:var(--text-on-deep-tertiary);margin:0;text-wrap:pretty">CredShields One keeps pentest evidence current release by release, which is increasingly what DORA and MAS TRM expect in practice. Manual engagements cover the formal annual requirement.</p>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a href="/" class="cs-btn cs-btn-lime cs-btn-md">Explore CredShields One</a>
          <a href="#contact" class="cs-btn cs-btn-secondary cs-btn-on-deep cs-btn-md">Talk it through</a>
        </div>
      </div>
    </div>
  </section>
  <section id="threats" data-screen-label="Threat landscape" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Threat landscape</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 16px;color:var(--color-forest);text-wrap:pretty">What actually goes wrong in financial products</h2>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">The breaches in this sector are rarely exotic. They are authorization and business logic.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">MONEY MOVEMENT</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Logic flaws in transfer and settlement</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Race conditions on balance checks, rounding abuse, and approval-chain bypass. These do not appear in any CVE feed because they are unique to your product.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">TENANT ISOLATION</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Cross-account data exposure</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Multi-tenant ledgers and merchant hierarchies where a sub-account can read or act on a parent. The most common critical we find in fintech.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">THIRD PARTY</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Partner and BaaS integrations</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Sponsor bank APIs, KYC providers, and card processors, each a trust relationship with its own authorization model and its own failure mode.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">REGULATORY</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Segmentation that does not hold</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Cardholder environments that are logically separated on the diagram but reachable in practice, which is what fails a PCI assessment.</p>
        </div>
      </div>
    </div>
  </section>
  <section id="regulation" data-screen-label="Regulation" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ What you have to prove</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 16px;color:var(--color-forest);text-wrap:pretty">What you have to prove, and to whom</h2>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">We scope testing to the requirement, then map the evidence to it.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px">
        <div>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:14px">CARD AND PAYMENTS</div>
          <div style="display:flex;flex-direction:column;gap:9px">
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>PCI DSS 4.0 Requirement 11.4 penetration testing</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>PCI DSS 6.3 secure development</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Segmentation testing at required intervals</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>ASV scanning alignment</span>
          </div>
        </div>
        <div>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:14px">OPERATIONAL RESILIENCE</div>
          <div style="display:flex;flex-direction:column;gap:9px">
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>DORA threat-led penetration testing</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>TIBER-EU framework alignment</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Third-party risk evidence</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Incident reporting readiness</span>
          </div>
        </div>
        <div>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:14px">REGIONAL</div>
          <div style="display:flex;flex-direction:column;gap:9px">
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>MAS TRM guidelines (Singapore)</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>RBI cybersecurity framework (India)</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>FCA operational resilience (UK)</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>NYDFS Part 500 (New York)</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section id="findings" data-screen-label="Common findings" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ What we keep finding</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 16px;color:var(--color-forest);text-wrap:pretty">What we keep finding in fintech</h2>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">From recent engagements in this sector.</p>
      <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);overflow:hidden;background:var(--surface-raised)">
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:9px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="cs-severity cs-severity-critical">Critical</span>
            <span class="cs-proof cs-proof-proven"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Proven</span>
            <span style="font:500 11px var(--font-mono);color:var(--color-danger-strong)">CVSS 9.1</span>
          </div>
          <div style="font:500 14.5px/1.4 var(--font-mono);color:var(--color-ink);text-wrap:pretty">Sub-merchant account read settlement data across the parent organization</div>
          <div style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);text-wrap:pretty">A role-confusion flaw in merchant onboarding meant any sub-merchant could query the parent hierarchy. Two years of quarterly scanning had never surfaced it.</div>
        </div>
        <div style="padding:20px 24px;border-top:1px solid var(--border-default);display:flex;flex-direction:column;gap:9px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="cs-severity cs-severity-high">High</span>
            <span class="cs-proof cs-proof-proven"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Proven</span>
            <span style="font:500 11px var(--font-mono);color:var(--color-warning-strong)">CVSS 8.0</span>
          </div>
          <div style="font:500 14.5px/1.4 var(--font-mono);color:var(--color-ink);text-wrap:pretty">Transfer limit bypassed by concurrent requests</div>
          <div style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);text-wrap:pretty">The balance check and the debit were not atomic. Twelve parallel requests moved twelve times the daily limit before the ledger caught up.</div>
        </div>
        <div style="padding:20px 24px;border-top:1px solid var(--border-default);display:flex;flex-direction:column;gap:9px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="cs-severity cs-severity-medium">Medium</span>
            <span class="cs-proof cs-proof-proven"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Proven</span>
            <span style="font:500 11px var(--font-mono);color:var(--color-warning-strong)">CVSS 6.5</span>
          </div>
          <div style="font:500 14.5px/1.4 var(--font-mono);color:var(--color-ink);text-wrap:pretty">KYC document store readable via predictable object keys</div>
          <div style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);text-wrap:pretty">Identity documents were stored with sequential keys behind a signed URL whose expiry was never enforced server-side.</div>
        </div>
      </div>
    </div>
  </section>
  <section id="services" data-screen-label="Services" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Where teams here start</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 16px;color:var(--color-forest);text-wrap:pretty">Where teams here start</h2>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">Most fintech clients run the platform on every release and add a manual engagement at audit time.</p>
      <div style="display:flex;flex-direction:column">
        <a href="/" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">CredShields One</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">Tested every release, with evidence that stays current</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more &#8594;</span>
        </a>
        <a href="/compliance" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">Compliance Readiness</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">PCI DSS, DORA, and SOC 2 evidence mapped to controls</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more &#8594;</span>
        </a>
        <a href="/api-security" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">API Security Testing</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">Payment and partner APIs, authorization matrix in full</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more &#8594;</span>
        </a>
        <a href="/red-team" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">Red Team Engagement</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">DORA and TIBER-EU aligned threat-led testing</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more &#8594;</span>
        </a>
      </div>
    </div>
  </section>
  <section id="proof" data-screen-label="Customer proof" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Customer proof</div>
