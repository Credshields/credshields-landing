---
import BaseLayout from "../layouts/BaseLayout.astro";
import GetStarted from "../components/GetStarted.astro";
import "../styles/industry-govtech.css";

const title = "Public Sector and GovTech - CredShields";
const description = "Citizen services, government platforms, and the vendors who build them. Scoped to the framework your contract cites, with evidence in the format it demands.";
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://credshields.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Industries",
      "item": "https://credshields.com/industries"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Public Sector and GovTech",
      "item": "https://credshields.com/industry-govtech/"
    }
  ]
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <div class="industry-govtech-page">
<section id="top" data-screen-label="Hero" style="background:var(--surface-page);border-bottom:1px solid var(--border-default);padding:150px 28px clamp(64px,8vw,88px);position:relative;overflow:hidden">
    <img src="images/about-icon-black.png" alt="" style="position:absolute;right:-60px;top:50%;transform:translateY(-50%);width:440px;height:440px;opacity:.045;pointer-events:none">
    <div style="max-width:1180px;margin:0 auto;position:relative;z-index:2">
      <span data-heroicon="" style="color:var(--color-forest);display:block;margin-bottom:18px;transform:scale(1.5);transform-origin:left center" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 7h2M13 7h2M9 11h2M13 11h2M10 21v-4h4v4"/></svg></span>
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--color-forest);border-radius:var(--radius-pill);padding:8px 16px;background:var(--color-forest-100);margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--color-forest);animation:pulseDot 2.6s infinite"></span>
        <span style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.18em">INDUSTRY · PUBLIC SECTOR AND GOVTECH</span>
      </div>
      <h1 style="font:700 clamp(34px,4.4vw,58px)/1.06 var(--font-display);letter-spacing:-.03em;margin:0;color:var(--color-forest);max-width:960px;text-wrap:pretty">Testing that meets the standard a government buyer names</h1>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:22px 0 30px;max-width:760px;text-wrap:pretty">Citizen services, government platforms, and the vendors who build them. Scoped to the framework your contract cites, with evidence in the format it demands.</p>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <a href="#contact" class="cs-btn cs-btn-lime cs-btn-lg">Get Scoped</a>
        <a href="" class="cs-btn cs-btn-secondary cs-btn-lg">See CredShields One</a>
      </div>
    </div>
  </section>
  <section data-screen-label="CredShields One" style="border-bottom:1px solid var(--border-default)">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(40px,6vw,64px) 28px">
      <div style="background:var(--surface-deep);border-radius:var(--radius-lg);padding:clamp(28px,4vw,44px);display:flex;flex-wrap:wrap;gap:32px;align-items:center;justify-content:space-between">
        <div style="flex:1 1 460px;max-width:640px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
            <span class="cs-badge cs-badge-lime">Start here</span>
            <span style="font:500 11px var(--font-mono);color:var(--text-on-deep-muted);letter-spacing:.16em">CREDSHIELDS ONE</span>
          </div>
          <h2 style="font:600 clamp(22px,2.4vw,30px)/1.15 var(--font-display);letter-spacing:-.02em;margin:0 0 10px;color:var(--text-on-deep-primary);max-width:640px;text-wrap:balance">Authorization boundaries change; evidence should keep up</h2>
          <p style="font:400 15px/1.65 var(--font-body);color:var(--text-on-deep-tertiary);margin:0;text-wrap:pretty">CredShields One provides evidence every release between formal assessments, which supports ongoing authorization requirements rather than a once-a-year snapshot.</p>
        </div>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a href="" class="cs-btn cs-btn-lime cs-btn-md">Explore CredShields One</a>
          <a href="#contact" class="cs-btn cs-btn-secondary cs-btn-on-deep cs-btn-md">Talk it through</a>
        </div>
      </div>
    </div>
  </section>
  <section id="threats" data-screen-label="Threat landscape" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Threat landscape</div>
      <h2 style="font: 600 var(--type-display-2)/1.08 var(--font-display); letter-spacing: -.025em; margin: 0 0 16px; color: var(--color-forest); text-wrap: pretty">What actually goes wrong in government platforms</h2>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">Legacy integration and identity assurance dominate.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">IDENTITY</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Citizen identity and assurance levels</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Identity proofing, credential recovery, and step-up authentication where the consequence of impersonation is a benefit or a record change.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">LEGACY</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Integration with systems nobody can change</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Mainframe and legacy connectors with shared service accounts and authorization models that predate the API in front of them.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">ACCESS</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Caseworker and administrative privilege</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Internal tooling with broad record access, frequently the least tested surface and the highest-value target.</p>
        </div>
        <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:26px;display:flex;flex-direction:column;gap:10px">
          <div style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em">SUPPLY CHAIN</div>
          <h3 style="font:600 18px/1.2 var(--font-display);letter-spacing:-.015em;margin:0;color:var(--color-ink);text-wrap:balance">Contractor and subcontractor access</h3>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Multi-vendor delivery where access is provisioned quickly at project start and rarely removed at the end.</p>
        </div>
      </div>
    </div>
  </section>
  <section id="regulation" data-screen-label="Regulation" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ What you have to prove</div>
      <h2 style="font: 600 var(--type-display-2)/1.08 var(--font-display); letter-spacing: -.025em; margin: 0 0 16px; color: var(--color-forest); text-wrap: pretty">What you have to prove, and to whom</h2>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">The contract names the framework. We test to it.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px">
        <div>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:14px">UNITED STATES</div>
          <div style="display:flex;flex-direction:column;gap:9px">
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>NIST SP 800-53 control assessment</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>FedRAMP readiness and continuous monitoring</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>FISMA annual testing requirements</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>StateRAMP for state and local</span>
          </div>
        </div>
        <div>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:14px">UNITED KINGDOM AND EU</div>
          <div style="display:flex;flex-direction:column;gap:9px">
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Cyber Essentials Plus</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>NCSC CAF principles</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>NIS2 technical and organizational measures</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>G-Cloud and framework tender evidence</span>
          </div>
        </div>
        <div>
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;padding-bottom:12px;border-bottom:1px solid var(--border-default);margin-bottom:14px">CROSS-CUTTING</div>
          <div style="display:flex;flex-direction:column;gap:9px">
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>ISO 27001:2022 Annex A</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Data residency and sovereignty requirements</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Accessibility alongside security in tenders</span>
            <span style="display:flex;align-items:baseline;gap:10px;font:400 14.5px/1.5 var(--font-body);color:var(--text-secondary)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;transform:translateY(2px)"><polyline points="20 6 9 17 4 12"></polyline></svg>Subcontractor security flow-down</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section id="findings" data-screen-label="Common findings" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ What we keep finding</div>
      <h2 style="font: 600 var(--type-display-2)/1.08 var(--font-display); letter-spacing: -.025em; margin: 0 0 16px; color: var(--color-forest); text-wrap: pretty">What we keep finding in public sector</h2>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:0 0 40px;text-wrap:pretty">From recent engagements in this sector.</p>
      <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);overflow:hidden;background:var(--surface-raised)">
        <div style="padding:20px 24px;display:flex;flex-direction:column;gap:9px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="cs-severity cs-severity-critical">Critical</span>
            <span class="cs-proof cs-proof-proven"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Proven</span>
            <span style="font:500 11px var(--font-mono);color:var(--color-danger-strong)">CVSS 9.4</span>
          </div>
          <div style="font:500 14.5px/1.4 var(--font-mono);color:var(--color-ink);text-wrap:pretty">A contractor VPN account from a closed project retained live access</div>
          <div style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);text-wrap:pretty">The account reused a password present in a public breach corpus. From there, lateral movement to a records file share was entirely unmonitored.</div>
        </div>
        <div style="padding:20px 24px;border-top:1px solid var(--border-default);display:flex;flex-direction:column;gap:9px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="cs-severity cs-severity-high">High</span>
            <span class="cs-proof cs-proof-proven"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Proven</span>
            <span style="font:500 11px var(--font-mono);color:var(--color-warning-strong)">CVSS 7.8</span>
          </div>
          <div style="font:500 14.5px/1.4 var(--font-mono);color:var(--color-ink);text-wrap:pretty">Caseworker tooling permitted record access outside assigned jurisdiction</div>
          <div style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);text-wrap:pretty">Authorization checked the caseworker role but not the geographic or departmental scope attached to it, exposing citizen records nationwide.</div>
        </div>
        <div style="padding:20px 24px;border-top:1px solid var(--border-default);display:flex;flex-direction:column;gap:9px">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span class="cs-severity cs-severity-medium">Medium</span>
            <span class="cs-proof cs-proof-proven"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>Proven</span>
            <span style="font:500 11px var(--font-mono);color:var(--color-warning-strong)">CVSS 6.2</span>
          </div>
          <div style="font:500 14.5px/1.4 var(--font-mono);color:var(--color-ink);text-wrap:pretty">Identity recovery flow accepted knowledge-based answers already public</div>
          <div style="font:400 14px/1.6 var(--font-body);color:var(--text-secondary);text-wrap:pretty">Account recovery relied on details available in public registers, allowing takeover without any technical exploit.</div>
        </div>
      </div>
    </div>
  </section>
  <section id="services" data-screen-label="Services" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Where teams here start</div>
      <h2 style="font:600 var(--type-display-2)/1.08 var(--font-display);letter-spacing:-.025em;margin:0 0 16px;color:var(--color-forest);text-wrap:pretty">Where teams here start</h2>
      <p style="font: 400 18px/1.65 var(--font-body); color: var(--text-secondary); margin: 0 0 40px; text-wrap: pretty">Public sector engagements are usually framework-driven, so scope follows the contract.</p>
      <div style="display:flex;flex-direction:column">
        <a href="compliance" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">Compliance Readiness</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">NIST, FedRAMP, and Cyber Essentials evidence</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more →</span>
        </a>
        <a href="red-team" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">Red Team Engagement</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">Objective-based testing with detection assessment</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more →</span>
        </a>
        <a href="web-pentest" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">Web App Pentesting</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">Citizen-facing services and caseworker tooling</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more →</span>
        </a>
        <a href="" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;padding:18px 4px;border-top:1px solid var(--border-default);border-bottom:1px solid var(--border-default);color:inherit" style-hover="background:var(--surface-sunken)">
          <div style="display:flex;align-items:baseline;gap:18px;flex-wrap:wrap">
            <span style="font:600 16.5px var(--font-display);letter-spacing:-.015em;color:var(--color-ink)">CredShields One</span>
            <span style="font:400 14px var(--font-body);color:var(--text-secondary)">Tested every release, evidence always current</span>
          </div>
          <span style="font:500 13px var(--font-body);color:var(--color-forest);white-space:nowrap">Learn more →</span>
        </a>
      </div>
    </div>
  </section>
  <section id="proof" data-screen-label="Customer proof" style="border-bottom:1px solid var(--border-default);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(56px,8vw,88px) 28px">
      <div style="font:500 12px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px">/ Customer proof</div>
      <h2 style="font: 600 var(--type-display-2)/1.08 var(--font-display); letter-spacing: -.025em; margin: 0 0 40px; color: var(--color-forest); text-wrap: pretty">A government platform, nine days</h2>
      
      <div style="border:1px solid var(--border-default);border-radius:var(--radius-md);padding:clamp(28px,4vw,44px);display:flex;flex-wrap:wrap;gap:40px;align-items:flex-start">
        <div style="flex:1 1 380px;max-width:620px">
          <div style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.14em;margin-bottom:16px">PUBLIC SECTOR · APAC</div>
          <p style="font:500 var(--type-pull-quote)/1.35 var(--font-display);letter-spacing:-.015em;color:var(--color-ink);margin:0 0 16px;text-wrap:balance">A contractor account nobody had closed was cheaper than any exploit we had prepared.</p>
          <p style="font:400 14.5px/1.6 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">The objective was access to a restricted records share. We never needed a vulnerability. An expired vendor relationship left a live VPN account whose password appeared in a public breach corpus. Detection logged the movement; nothing escalated it for six days.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;min-width:180px">
          <div><div style="font:700 30px var(--font-display);letter-spacing:-.02em;color:var(--color-forest)">9d</div><div style="font:500 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em;margin-top:4px">TO OBJECTIVE</div></div>
          <div><div style="font:700 30px var(--font-display);letter-spacing:-.02em;color:var(--color-forest)">0</div><div style="font:500 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em;margin-top:4px">EXPLOITS USED</div></div>
          <div><div style="font:700 30px var(--font-display);letter-spacing:-.02em;color:var(--color-forest)">6d</div><div style="font:500 10px var(--font-mono);color:var(--text-secondary);letter-spacing:.14em;margin-top:4px">ALERT SAT UNREAD</div></div>
        </div>
      </div>
    </div>
  </section>
  <section data-screen-label="Timing" style="border-bottom:1px solid var(--border-default)">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(48px,7vw,72px) 28px">
      <div style="border-left:3px solid var(--color-forest);padding:8px 0 8px 24px;max-width:760px">
        <p style="font:500 var(--type-pull-quote)/1.35 var(--font-display);letter-spacing:-.015em;color:var(--color-ink);margin:0 0 14px;text-wrap:balance">Tender deadlines are fixed. Evidence has to exist by then.</p>
        <p style="font:400 15.5px/1.65 var(--font-body);color:var(--text-secondary);margin:0;text-wrap:pretty">Public procurement rarely allows extensions, and security evidence is usually a pass or fail gate rather than a scored criterion. Send us the tender requirements and we will tell you plainly what testing it needs and whether the date is achievable.</p>
      </div>
    </div>
  </section>
  <section id="faq" data-screen-label="FAQ" style="border-bottom:1px solid var(--border-default);">
