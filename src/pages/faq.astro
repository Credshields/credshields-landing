---
import BaseLayout from "../layouts/BaseLayout.astro";
import GetStarted from "../components/GetStarted.astro";
import "../styles/faq.css";

const title = "FAQ - CredShields";
const description = "Answers to the questions we get most: getting started, how CredShields One works, services, compliance evidence, data handling, Web3, and pricing.";
---
<BaseLayout title={title} description={description}>
  <div class="faq-page">
<section id="top" data-screen-label="Hero" style="background:var(--surface-page);border-bottom:1px solid var(--border-default);padding:150px 28px clamp(64px,8vw,88px);position:relative;overflow:hidden">
    <img src="/images/about-icon-black.png" alt="" style="position:absolute;right:-60px;top:50%;transform:translateY(-50%);width:440px;height:440px;opacity:.045;pointer-events:none">
    <div style="max-width:1180px;margin:0 auto;position:relative;z-index:2">
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--color-forest);border-radius:var(--radius-pill);padding:8px 16px;background:var(--color-forest-100);margin-bottom:26px">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--color-forest);animation:pulseDot 2.6s infinite"></span>
        <span style="font:500 11px var(--font-mono);color:var(--color-forest-600);letter-spacing:.18em">FAQ</span>
      </div>
      <h1 style="font:700 clamp(34px,4.4vw,58px)/1.06 var(--font-display);letter-spacing:-.03em;margin:0;color:var(--color-forest);max-width:960px;text-wrap:pretty">Questions, answered plainly</h1>
      <p style="font:400 18px/1.65 var(--font-body);color:var(--text-secondary);margin:22px 0 30px;max-width:760px;text-wrap:pretty">Everything we get asked before an engagement, in one place. If your question is not here, ask a human and one will answer within a business day.</p>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <a href="#contact" class="cs-btn cs-btn-lime cs-btn-lg">Get Scoped</a>
        <a href="/" class="cs-btn cs-btn-secondary cs-btn-lg">See CredShields One</a>
      </div>
    </div>
  </section>
  <section id="faq" data-screen-label="FAQ" style="border-bottom:1px solid var(--border-default)">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(48px,7vw,72px) 28px">
      <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-bottom:20px">
        <input data-faq-search placeholder="Search the questions…" style="flex:1 1 280px;padding:13px 16px;border:1px solid var(--border-default);border-radius:var(--radius-sm);background:var(--surface-raised);font:400 15px var(--font-body);color:var(--color-ink);outline:none">
        <span style="font:500 11px var(--font-mono);color:var(--text-secondary);letter-spacing:.1em"><span data-faq-count></span></span>
        <button data-faq-toggle-all type="button" style="font:500 11px var(--font-mono);color:var(--color-forest);letter-spacing:.1em;background:none;border:none;cursor:pointer;padding:0;font-family:inherit">Expand all</button>
      </div>
      <div data-faq-filters style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px">
        <button data-filter-btn="all" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--color-forest);background:var(--color-forest);color:#fff;cursor:pointer">All</button>
        <button data-filter-btn="start" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Getting started</button>
        <button data-filter-btn="product" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">CredShields One</button>
        <button data-filter-btn="services" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Services</button>
        <button data-filter-btn="compliance" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Compliance</button>
        <button data-filter-btn="security" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Security &amp; data</button>
        <button data-filter-btn="web3" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Web3</button>
        <button data-filter-btn="commercial" style="font:500 12.5px var(--font-mono);letter-spacing:.04em;border-radius:var(--radius-pill);padding:8px 16px;border:1px solid var(--border-default);background:var(--surface-page);color:var(--color-ink);cursor:pointer">Pricing &amp; contracts</button>
      </div>
      <div data-faq-grid style="display:flex;flex-direction:column;border-bottom:1px solid var(--border-default)">
        <div data-cat="start" data-q="how do we get started? use the get scoped form. you will get a scope, a quote, and a delivery date within one business day. work can begin in hours or days from there, depending on scope and the timeline we agree." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">GETTING STARTED</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">How do we get started?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font: 400 15px/1.65 var(--font-body); color: var(--text-secondary); margin: 0; text-wrap: pretty">Use the Get scoped form. You will get a scope, a quote, and a delivery date within one business day. Work can begin in hours or days from there, depending on scope and the timeline we agree.</p>
          <a href="#contact" style="font:500 13px var(--font-body);color:var(--color-forest);display:inline-block;margin-top:10px">Get scoped →</a>
        </div>
        </div>
        <div data-cat="start" data-q="what do you need from us to begin? test accounts for each user role, network access if the target is not public, and a technical contact. documentation helps but is not required. missing access is the single biggest cause of lost test days." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">GETTING STARTED</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">What do you need from us to begin?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font: 400 15px/1.65 var(--font-body); color: var(--text-secondary); margin: 0; text-wrap: pretty">Test accounts for each user role, network access if the target is not public, and a technical contact. Documentation helps but is not required. Missing access is the single biggest cause of lost test days.</p>

        </div>

        </div>
        <div data-cat="start" data-q="how quickly can you start? fast. scoping is a 30-minute call, and work can begin in hours or days depending on scope and the timeline we agree. credshields one can be pointed at a target the same day. if you have a fixed audit or launch date, tell us and we will confirm it fits." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">GETTING STARTED</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">How quickly can you start?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font: 400 15px/1.65 var(--font-body); color: var(--text-secondary); margin: 0; text-wrap: pretty">Fast. Scoping is a 30-minute call, and work can begin in hours or days depending on scope and the timeline we agree. CredShields One can be pointed at a target the same day. If you have a fixed audit or launch date, tell us and we will confirm it fits.</p>

        </div>

        </div>
        <div data-cat="start" data-q="not sure whether we need the platform or an engagement? say so on the form. if your release cadence is quarterly, an engagement is probably right. if you ship weekly, the platform covers the gap an annual test leaves. we will tell you which fits rather than recommend both." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">GETTING STARTED</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">Not sure whether we need the platform or an engagement?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font: 400 15px/1.65 var(--font-body); color: var(--text-secondary); margin: 0; text-wrap: pretty">Say so on the form. If your release cadence is quarterly, an engagement is probably right. If you ship weekly, the platform covers the gap an annual test leaves. We will tell you which fits rather than recommend both.</p>
          <a href="/services" style="font:500 13px var(--font-body);color:var(--color-forest);display:inline-block;margin-top:10px">Compare the two →</a>
        </div>
        </div>
        <div data-cat="start" data-q="are you sure we are even ready for a pentest? take the readiness assessment. twelve questions, three minutes, and a scored report telling you what to prepare first. a test run before you are ready spends its budget on setup rather than findings." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">GETTING STARTED</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">Are you sure we are even ready for a pentest?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font: 400 15px/1.65 var(--font-body); color: var(--text-secondary); margin: 0; text-wrap: pretty">Take the readiness assessment. The assessment will hand you a scored report telling you what to prepare first. A test run before you are ready spends its budget on setup rather than findings.</p>
          <a href="/pentest-readiness" style="font:500 13px var(--font-body);color:var(--color-forest);display:inline-block;margin-top:10px">Take the assessment →</a>
        </div>
        </div>
        <div data-cat="product" data-q="what is credshields one? an ai pentester that discovers, exploits, and proves vulnerabilities across your web, mobile, cloud, and api surface, running on your release cadence. a senior human validates every finding before it reaches you." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">CREDSHIELDS ONE</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">What is CredShields One?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font: 400 15px/1.65 var(--font-body); color: var(--text-secondary); margin: 0; text-wrap: pretty">An AI pentester that discovers, exploits, and proves vulnerabilities across your web, mobile, cloud, and API surface, running on your release cadence. A senior human validates every finding before it reaches you.</p>
          <a href="/" style="font:500 13px var(--font-body);color:var(--color-forest);display:inline-block;margin-top:10px">See the platform →</a>
        </div>
        </div>
        <div data-cat="product" data-q="is it a scanner? no, and the test is simple: ask whether every finding arrives with a reproduced exploit chain and a named human who confirmed it. ours do. a scanner reports that a pattern resembles a vulnerability; we report that we exploited it." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">CREDSHIELDS ONE</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">Is it a scanner?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font:400 15px/1.65 var(--font-body);color:var(--text-secondary);margin:0;max-width:760px;text-wrap:pretty">No, and the test is simple: ask whether every finding arrives with a reproduced exploit chain and a named human who confirmed it. Ours do. A scanner reports that a pattern resembles a vulnerability; we report that we exploited it.</p>
          <a href="Guide - Pentest vs Vulnerability Scan.html" style="font:500 13px var(--font-body);color:var(--color-forest);display:inline-block;margin-top:10px">Pentest vs scan →</a>
        </div>
        </div>
        <div data-cat="product" data-q="how is it different from continuous scanning? cadence is not the difference; validation is. running a scanner hourly produces more unvalidated output, not more assurance. we apply the same standard as a point-in-time engagement, more often." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">CREDSHIELDS ONE</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">How is it different from continuous scanning?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font: 400 15px/1.65 var(--font-body); color: var(--text-secondary); margin: 0; text-wrap: pretty">Validation is the difference, and cadence follows from it. Running a scanner hourly produces more unvalidated output. We apply the same standard as a point-in-time engagement, more often.</p>
          <a href="Guide - What is Continuous Pentesting.html" style="font:500 13px var(--font-body);color:var(--color-forest);display:inline-block;margin-top:10px">Continuous pentesting →</a>
        </div>
        </div>
        <div data-cat="product" data-q="will it disrupt production? no. you choose the environment and the scope, guardrails are agreed in advance, and destructive actions are out of scope by default. we recommend staging or uat during a proof of concept." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">CREDSHIELDS ONE</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">Will it disrupt production?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font: 400 15px/1.65 var(--font-body); color: var(--text-secondary); margin: 0; text-wrap: pretty">No. You choose the environment and the scope, guardrails are agreed in advance, and destructive actions are out of scope by default. We recommend staging or UAT during a proof of concept.</p>

        </div>

        </div>
        <div data-cat="product" data-q="does it integrate with our tooling? findings sync to jira, linear, or github issues, and route to slack or teams by service owner. merge gates can be tuned to block only on proven findings." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">CREDSHIELDS ONE</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">Does it integrate with our tooling?</h3>
            <span data-faq-icon="" style="flex-shrink:0;color:var(--color-forest);font:400 20px var(--font-mono);line-height:1.2;transition:transform .2s ease">+</span>
          </button>
          <div data-faq-a="" style="display:none;padding-top:10px">
            <p style="font: 400 15px/1.65 var(--font-body); color: var(--text-secondary); margin: 0; text-wrap: pretty">Findings sync to Jira, Linear, or GitHub Issues, and route to Slack or Teams by service owner. Merge gates can be tuned to block only on proven findings.</p>
          <a href="/devsecops" style="font:500 13px var(--font-body);color:var(--color-forest);display:inline-block;margin-top:10px">DevSecOps integration →</a>
        </div>
        </div>
        <div data-cat="product" data-q="what happens when we push a fix? the exact chain that broke you is re-run against the patch. retests are included for the life of the engagement, with no new statement of work." style="border-top:1px solid var(--border-default);padding:24px 0">
          <div style="font:500 10px var(--font-mono);color:var(--color-forest);letter-spacing:.12em;margin-bottom:8px">CREDSHIELDS ONE</div>
          <button data-faq-q="" type="button" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;width:100%;background:none;border:none;padding:0;cursor:pointer;text-align:left;font-family:inherit">
            <h3 style="font:600 18px/1.3 var(--font-display);letter-spacing:-.015em;margin:0 0 8px;color:var(--color-ink);text-wrap:pretty">What happens when we push a fix?</h3>
