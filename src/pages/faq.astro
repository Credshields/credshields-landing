  <script>
    import "../../js/main.v1.js";
    import "../../js/homepage-rehaul.js";
    const search = document.querySelector("[data-faq-search]");
    const filters = document.querySelector("[data-faq-filters]");
    const grid = document.querySelector("[data-faq-grid]");
    const count = document.querySelector("[data-faq-count]");
    const empty = document.querySelector("[data-faq-empty]");
    const toggleAll = document.querySelector("[data-faq-toggle-all]");
    let category = "all";
    const items = [...grid.querySelectorAll("[data-cat]")];
    const setAnswer = (item, open) => {
      item.querySelector("[data-faq-a]").style.display = open ? "block" : "none";
      item.querySelector("[data-faq-icon]").textContent = open ? "−" : "+";
    };
    const applyFilters = () => {
      const query = (search?.value ?? "").trim().toLowerCase();
      let shown = 0;
      items.forEach((item) => {
        const visible = (category === "all" || item.dataset.cat === category) && (!query || item.dataset.q.includes(query));
        item.style.display = visible ? "" : "none";
        if (visible) shown += 1;
      });
      count.textContent = `${shown} OF ${items.length} QUESTIONS`;
      empty.style.display = shown ? "none" : "block";
      filters.querySelectorAll("[data-filter-btn]").forEach((button) => {
        const active = button.dataset.filterBtn === category;
        button.style.background = active ? "var(--color-forest)" : "var(--surface-page)";
        button.style.color = active ? "#fff" : "var(--color-ink)";
        button.style.borderColor = active ? "var(--color-forest)" : "var(--border-default)";
      });
    };
    items.forEach((item) => item.querySelector("[data-faq-q]").addEventListener("click", () => {
      const answer = item.querySelector("[data-faq-a]");
      setAnswer(item, answer.style.display !== "block");
    }));
    search?.addEventListener("input", applyFilters);
    filters.querySelectorAll("[data-filter-btn]").forEach((button) => button.addEventListener("click", () => { category = button.dataset.filterBtn; applyFilters(); }));
    toggleAll?.addEventListener("click", () => {
      const shouldOpen = toggleAll.textContent === "Expand all";
      items.filter((item) => item.style.display !== "none").forEach((item) => setAnswer(item, shouldOpen));
      toggleAll.textContent = shouldOpen ? "Collapse all" : "Expand all";
    });
    applyFilters();
  </script>
